<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
        x:Class="StorageHub.Desktop.Views.MainWindow"
        x:DataType="vm:ShellPreviewModel"
        Title="StorageHub"
        Width="1500" Height="920"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen">

  <!--
    The shell's structure, and nothing else: no colour, no pixel, no font. Every number below is a
    token from DesignTokens.axaml, which is what makes the appearance changeable in one file and
    what makes 125% scaling a non-event - Avalonia lays this out in device-independent pixels, so
    the same markup is correct at every scaling on both platforms.
  -->

  <DockPanel>

    <!-- In-window rather than NativeMenu: the requirement is the same classic menu bar on both
         platforms, and NativeMenu on Linux needs a dbusmenu host GNOME does not ship. -->
    <Menu x:Name="PART_Menu" DockPanel.Dock="Top" ItemsSource="{Binding Menus}">
      <Menu.ItemTemplate>
        <DataTemplate DataType="vm:MenuSection">
          <TextBlock Text="{Binding Header}"/>
        </DataTemplate>
      </Menu.ItemTemplate>
      <Menu.Styles>
        <!-- The nine menus come straight from the catalog. Setting ItemsSource through a style
             rather than an ItemContainerTheme is deliberate: a theme based on {x:Type MenuItem}
             is Avalonia's *nested* menu item, so applying it to a menu bar made every root behave
             like a submenu - opening to the right of its header instead of below it. Leaving the
             container theme alone keeps the top-level one Avalonia already assigns. -->
        <Style Selector="Menu > MenuItem" x:DataType="vm:MenuSection">
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </Style>

        <!-- InputGesture only displays the shortcut; dispatch comes from ShellCommandRouter, which
             owns the key each entry shows, so a shortcut rebound in Settings changes both at once.
             A label of "-" is a separator, which is how the Workspace menu divides its pinned and
             recent workspaces from the rest. -->
        <Style Selector="MenuItem > MenuItem" x:DataType="vm:CommandEntry">
          <Setter Property="Header" Value="{Binding Label}"/>
          <Setter Property="InputGesture" Value="{Binding Shortcut.Gesture}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"/>
          <!-- Shown on a dimmed entry too, as 1.x's menus showed it: Go's "No favorite
               connections" says how to make one only there. -->
          <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
          <Setter Property="ItemsSource" Value="{x:Null}"/>
          <!-- A tick on an entry that shows or hides something, View > Connections Panel's while
               the panel is showing. One way: a click ticks the item and runs its command, and
               the tick then follows whatever the panel did, however it was toggled. The tick is
               drawn as a frame around the entry's icon, as 1.x drew it, rather than in a column
               of its own that would widen the menu while something is ticked. -->
          <Setter Property="ToggleType" Value="{Binding ToggleType}"/>
          <Setter Property="IsChecked" Value="{Binding Check.IsChecked}"/>
          <Setter Property="Icon">
            <Template>
              <Border Classes="menu-check" Classes.checked="{Binding Check.IsChecked}">
                <LucideIcon Kind="{Binding Icon}"
                            IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Size="{StaticResource IconSizeSm}"
                            Classes.primary="{Binding IsPrimary}"
                            Classes.danger="{Binding IsDanger}"/>
              </Border>
            </Template>
          </Setter>
        </Style>
      </Menu.Styles>
    </Menu>

    <!-- Avalonia has no ToolBar; an ItemsControl over the resolved command ids is the shape, and it
         keeps the toolbar data-driven the way UiCommandCatalog already made it. The ids are the
         saved layout's, and Settings' label style shows each button's label beside or under its
         icon, which the "labels" and "under" classes turn on in ControlThemes. -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <!-- What does not fit goes behind a chevron at the right end, as 1.x's ToolStrip put it:
           the row leaves the chevron room once something has to go, and MainWindow shows it and
           fills its menu with what went. -->
      <Panel>
        <ItemsControl x:Name="PART_Toolbar" ItemsSource="{Binding Toolbar}"
                      Classes.labels="{Binding ToolbarShowsLabels}"
                      Classes.under="{Binding ToolbarLabelsUnderIcons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <vm:ToolbarOverflowPanel Spacing="{StaticResource SpaceXs}"
                                       OverflowReserve="{StaticResource ToolbarOverflowWidth}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- Two templates matched by type, so ToolbarLayout's separator entries need no flag and no
               converter: the layout is a list of ids with "|" in it, exactly as it is persisted. -->
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:CommandEntry">
              <!-- "checked" frames a button while what it shows is showing, as 1.x drew the
                   connections panel's (ui-reference 01). -->
              <Button Classes="tool" Command="{Binding Command}" ToolTip.Tip="{Binding Description}"
                      AutomationProperties.Name="{Binding Label}"
                      Classes.checked="{Binding Check.IsChecked}">
                <StackPanel Classes="tool-content">
                  <LucideIcon Kind="{Binding Icon}"
                              Size="{StaticResource IconSizeMd}"
                              Classes.primary="{Binding IsPrimary}"
                              Classes.danger="{Binding IsDanger}"/>
                  <TextBlock Classes="tool-label" Text="{Binding Label}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
            <DataTemplate DataType="vm:ToolbarSeparator">
              <Border Classes="toolbar-separator"/>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
        <Button x:Name="PART_ToolbarOverflow" Classes="tool" IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="{StaticResource ToolbarOverflowWidth}"
                ToolTip.Tip="{x:Static vm:ShellPreviewModel.MoreToolbarCommandsLabel}"
                AutomationProperties.Name="{x:Static vm:ShellPreviewModel.MoreToolbarCommandsLabel}">
          <LucideIcon Kind="ChevronsRight" Size="{StaticResource IconSizeMd}"/>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight"/>
          </Button.Flyout>
        </Button>
      </Panel>
    </Border>

    <!-- 1.4's StatusStrip: where the active pane is, what is selected, how fast the transfers
         move, the queue and the agent, one row tall with a line after each cell from the rate
         on, and 1.4's update link last. The first cell also carries 1.4's short messages for a while, such as what was just
         staged; the rate is 0 B/s while nothing moves, as 1.4's said. -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar"
            AutomationProperties.Name="{x:Static vm:ShellPreviewModel.ApplicationStatusLabel}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="muted status-cell" Text="{Binding ShellStatus.Location}"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="{x:Static vm:ShellPreviewModel.CurrentLocationLabel}"/>
        <TextBlock Grid.Column="1" Classes="muted status-cell" Text="{Binding ShellStatus.SelectionText}"
                   AutomationProperties.Name="{x:Static vm:ShellPreviewModel.SelectionSummaryLabel}"/>
        <Border Grid.Column="2" Classes="statusbar-separator"/>
        <TextBlock Grid.Column="3" Classes="muted status-cell" Text="{Binding ShellStatus.TransferRateText}"
                   AutomationProperties.Name="{x:Static vm:ShellPreviewModel.TransferSpeedLabel}"/>
        <Border Grid.Column="4" Classes="statusbar-separator"/>
        <TextBlock Grid.Column="5" Classes="muted status-cell" Text="{Binding ShellStatus.QueueText}"
                   AutomationProperties.Name="{x:Static vm:ShellPreviewModel.QueueSummaryLabel}"/>
        <Border Grid.Column="6" Classes="statusbar-separator"/>
        <!-- Where somebody looks when something has stopped working, so a click on it opens the
             controls that fix it, as 1.4's did. Its tooltip is what the agent last said. Not a tab
             stop and it takes no focus, as a status cell did not; the Tools menu has the keys. -->
        <Button Grid.Column="7" Classes="status-cell" Focusable="False"
                Command="{Binding AgentControlCommand}"
                ToolTip.Tip="{Binding AgentToolTip}"
                AutomationProperties.Name="{x:Static vm:ShellPreviewModel.AgentStatusLabel}">
          <TextBlock Classes="agent" Text="{Binding ShellStatus.AgentText}"
                     Classes.healthy="{Binding ShellStatus.AgentIsHealthy}"
                     Classes.degraded="{Binding ShellStatus.AgentIsDegraded}"
                     Classes.down="{Binding ShellStatus.AgentIsDown}"/>
        </Button>
        <Border Grid.Column="8" Classes="statusbar-separator"/>
        <!-- 1.4's update link, after the last line: what the updater last said, coloured as 1.4
             coloured it, and a click opens the update window, as Help, Check for updates does. -->
        <Button Grid.Column="9" Classes="status-cell link" Focusable="False"
                Command="{Binding UpdateCheckCommand}"
                ToolTip.Tip="{x:Static vm:ShellPreviewModel.UpdateStatusToolTip}"
                AutomationProperties.Name="{x:Static vm:ShellPreviewModel.UpdateStatusLabel}">
          <TextBlock Classes="update" Text="{Binding Update.Message}"
                     Classes.ready="{Binding UpdateIsReady}"
                     Classes.available="{Binding UpdateIsAvailable}"
                     Classes.failed="{Binding UpdateFailed}"/>
        </Button>
      </Grid>
    </Border>

    <!-- What the two nested SplitContainers become. ApplyConnectionsPanelSide, which was 130 lines
         of width arithmetic, is a swap of two Grid.Column values here: MainWindow.axaml.cs puts
         the panel in the first or the last column, at its saved width, or hides it with its
         splitter. The splitter stays in the middle column, between whichever two they are. -->
    <Grid x:Name="PART_Body" ColumnDefinitions="Auto,Auto,*">
      <Border x:Name="PART_ConnectionsPanel" Grid.Column="0" Classes="surface"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <vm:ConnectionsPanelView DataContext="{Binding Sidebar}"/>
      </Border>

      <GridSplitter x:Name="PART_ConnectionsSplitter" Grid.Column="1"
                    Width="{StaticResource SplitterThickness}"/>

      <!-- The queue's row is sized in code, from TransferQueueHeight, and both rows have the
           minimums MainWindow works out from what is in them, so the splitter between them stops
           before either loses its chrome (docs/ui-rules.md, Layout). -->
      <Grid x:Name="PART_WorkArea" Grid.Column="2" RowDefinitions="*,Auto,Auto">
        <TabControl x:Name="PART_WorkspaceTabs" Grid.Row="0" ItemsSource="{Binding Workspaces}"
                    SelectedIndex="{Binding SelectedWorkspace}"
                    Theme="{StaticResource WorkspaceTabControl}">
          <!-- The "+" that adds a workspace. A sibling of the strip rather than a tab in it: the
               WinForms shell used a sentinel TabPage and vetoed selecting it in
               WorkspaceTabsSelecting, and Avalonia's TabControl.SelectionChanged cannot be
               cancelled. Templated into the strip, so it follows the last tab at any width. -->
          <TabControl.Tag>
            <Button Classes="tool tab-add" Command="{Binding NewWorkspaceCommand}"
                    ToolTip.Tip="{Binding NewWorkspaceLabel}">
              <LucideIcon Kind="Plus" Size="{StaticResource IconSizeSm}"/>
            </Button>
          </TabControl.Tag>
          <TabControl.ItemTemplate>
            <DataTemplate DataType="vm:WorkspaceTab">
              <!-- A workspace carries its own close button, as 1.x's tabs did; Welcome and Sync
                   tasks are the shell's own pages and stay. -->
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                          ToolTip.Tip="{Binding ToolTip}"
                          AutomationProperties.Name="{Binding AccessibleName}">
                <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                <Button Classes="tool tab-close" IsVisible="{Binding IsClosable}"
                        Command="{Binding $parent[TabControl].((vm:ShellPreviewModel)DataContext).CloseWorkspaceCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{x:Static vm:ShellPreviewModel.CloseWorkspaceLabel}"
                        AutomationProperties.Name="{x:Static vm:ShellPreviewModel.CloseWorkspaceLabel}">
                  <LucideIcon Kind="X" Size="12"/>
                </Button>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate DataType="vm:WorkspaceTab">
              <!-- A tab either carries a page of its own - Welcome, Sync tasks - or it is a
                   workspace, which is the pane grid. One template, chosen by whether Page is set. -->
              <Panel>
                <ContentControl Content="{Binding Page}"
                                IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:OverviewModel">
                      <vm:OverviewView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SyncTasksModel">
                      <vm:SyncTasksView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SyncRunHistoryModel">
                      <vm:SyncRunHistoryView/>
                    </DataTemplate>
                    <!-- A page that is itself tabbed. Sync tasks is the first, and the shape is
                         reusable rather than a second tab control written into the shell. -->
                    <DataTemplate DataType="vm:TabbedPageModel">
                      <TabControl ItemsSource="{Binding Tabs}" Classes="subtabs"
                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                          <DataTemplate DataType="vm:PageTab">
                            <TextBlock Text="{Binding Title}"/>
                          </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                          <DataTemplate DataType="vm:PageTab">
                            <ContentControl Content="{Binding Content}">
                              <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:SyncTasksModel">
                                  <vm:SyncTasksView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:SyncRunHistoryModel">
                                  <vm:SyncRunHistoryView/>
                                </DataTemplate>
                              </ContentControl.DataTemplates>
                            </ContentControl>
                          </DataTemplate>
                        </TabControl.ContentTemplate>
                      </TabControl>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>

                <!--
                  The panes of a workspace: one to four, in whichever arrangement is chosen above
                  them. Each is a real browser on its own connection, or an SSH terminal. What is
                  staged for a transfer is shown between the chooser and the panes, because with
                  four panes it is the only thing that says where a paste would come from.
                -->
                <DockPanel Margin="{StaticResource PaddingMd}"
                           IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNull}}">

                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                              DataContext="{Binding Workspace}"
                              Spacing="{StaticResource SpaceXs}"
                              Margin="0,0,0,4">
                    <!--
                      The strip above the panes, as 1.x had it (ui-reference 05): how panes are
                      rearranged, what is staged ("Empty" when nothing is), and pasting it into the
                      active pane or clearing it. Always there, so the paste has a place to be found
                      rather than appearing only once something is staged.
                    -->
                    <LucideIcon Kind="Layers" Size="{StaticResource IconSizeSm}" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding DragPaneHeadersHint}"/>
                    <Border Classes="toolbar-separator"/>
                    <LucideIcon Kind="Clipboard" Size="{StaticResource IconSizeSm}" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding ClipboardText}"
                               FontWeight="SemiBold"/>
                    <Button Classes="tool" Command="{Binding PasteCommand}"
                            ToolTip.Tip="{Binding PasteToActivePaneLabel}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <LucideIcon Kind="ClipboardPaste" Size="{StaticResource IconSizeSm}"/>
                        <TextBlock Classes="caption" Text="{Binding PasteToActivePaneLabel}"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding ClearClipboardCommand}"
                            ToolTip.Tip="{Binding ClearStagedLabel}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <LucideIcon Kind="X" Size="{StaticResource IconSizeSm}"/>
                        <TextBlock Classes="caption" Text="{Binding ClearLabel}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <vm:WorkspaceView DataContext="{Binding Workspace}"/>
                </DockPanel>
              </Panel>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <GridSplitter x:Name="PART_QueueSplitter" Grid.Row="1" Height="{StaticResource SplitterThickness}"
                      HorizontalAlignment="Stretch"/>

        <Border x:Name="PART_Queue" Grid.Row="2" Classes="surface"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <!-- The queue and its Logs tab are a view of their own now; see TransferQueueView. -->
          <vm:TransferQueueView x:Name="PART_QueueView" DataContext="{Binding Queue}"/>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
