<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.PromptWindow"
        x:DataType="vm:PromptModel"
        Title="{Binding Title}"
        Width="{StaticResource DialogPromptWidth}" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">

  <!--
    One box and two buttons. The accept button is dim while the name is one the storage would
    refuse, with the reason underneath: a dialog that lets somebody press Create onto a refusal has
    made them do the work twice.
  -->

  <DockPanel>
    <!-- The same footer band as the message box, with the buttons in Windows' order. -->
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="{StaticResource SpaceMd}">
        <Button Classes="dialog primary" Content="{Binding Accept}"
                IsDefault="True" Command="{Binding AcceptCommand}"/>
        <Button Classes="dialog" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"/>
      </StackPanel>
    </Border>

    <StackPanel Margin="{StaticResource DialogContentPadding}" Spacing="{StaticResource SpaceSm}">
      <TextBlock Text="{Binding Label}"/>
      <TextBox x:Name="PART_Value"
               Text="{Binding Value, Mode=TwoWay}"
               PasswordChar="{Binding PasswordChar}"
               AutomationProperties.Name="{Binding Label}"/>
      <TextBlock Classes="caption danger"
                 IsVisible="{Binding HasError}"
                 Text="{Binding Error}"
                 TextWrapping="Wrap"/>
    </StackPanel>
  </DockPanel>
</Window>
