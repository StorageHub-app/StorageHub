<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StorageHub.Desktop.Views.DialogWindow"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">

  <!--
    StorageHub's message box, laid out as the Windows one is, which is what 1.4 showed: the title
    in the title bar, a 32 px icon beside the message on the window's own background, and a band
    along the foot holding the buttons on the right in the order Windows uses (OK Cancel, Yes No
    Cancel), with a checkbox such as "Don't show this again" on the left of that band.

    The window takes the width of its text between a minimum and a maximum, and wraps at the
    maximum, because the detail line is a path or an exception message and no fixed size suits
    both a one-line question and a paragraph.
  -->

  <!-- The width limits sit on the content rather than the window: a window sized to its content
       takes the content's size and does not apply its own minimum on every platform. -->
  <DockPanel MinWidth="{StaticResource DialogMinWidth}" MaxWidth="{StaticResource DialogMaxWidth}">

    <!-- Docked first: a docked child claims its edge before the body fills what is left, so the
         buttons stay on screen however tall the message grows. -->
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <DockPanel>
        <StackPanel Name="PART_Actions"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource SpaceMd}"/>
        <CheckBox Name="PART_CheckBox"
                  IsVisible="False"
                  Margin="{StaticResource DialogFooterCheckBoxMargin}"/>
      </DockPanel>
    </Border>

    <Grid Margin="{StaticResource DialogContentPadding}"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="{StaticResource SpaceLg}">

      <LucideIcon Name="PART_Icon"
                  Grid.Column="0"
                  Size="{StaticResource DialogIconSize}"
                  VerticalAlignment="Top"/>

      <!-- Selectable, as a Windows message box's text can be copied: the detail is often a path or
           an error somebody needs to paste somewhere. -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <SelectableTextBlock Name="PART_Message"
                             FontSize="{StaticResource FontSizeSubtitle}"
                             TextWrapping="Wrap"/>
        <SelectableTextBlock Name="PART_Detail"
                             Margin="{StaticResource DialogDetailMargin}"
                             TextWrapping="Wrap"
                             IsVisible="False"/>
      </StackPanel>
    </Grid>

  </DockPanel>
</Window>
