<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
             xmlns:themes="clr-namespace:StorageHub.Desktop.Themes"
             x:Class="StorageHub.Desktop.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneModel">

  <!--
    One pane: which connection, where in it, and what is there. The order down the panel is the
    order somebody works in - choose a connection, see the path, move through it, read the listing -
    and it is the order BrowserPaneControl put them in too.

    The ".." row is part of the listing rather than a button beside it, which is how every file
    manager since Norton Commander has done it and what makes a double-click enough to go up.
  -->

  <Border Classes="pane" Classes.active="{Binding IsActive}">
    <DockPanel>

      <!--
        The pane's own title bar. It says which pane this is and whether it is the active one,
        which with four panes is the difference between knowing where a paste lands and guessing.
        Everything that changes the arrangement is behind its menu rather than along the toolbar:
        an arrangement is settled once and then wants the width back.
      -->
      <!-- The connection's colour across the top of the pane, as 1.x drew it. -->
      <Border DockPanel.Dock="Top" Height="3" Background="{Binding AccentBrush}"
              IsVisible="{Binding HasBadges}"/>

      <Border x:Name="PART_Header" DockPanel.Dock="Top" Classes="pane-header"
              Cursor="SizeAll">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                     FontWeight="SemiBold" Text="{Binding PaneHeading}"/>
          <Button Grid.Column="1" Classes="tool"
                  AutomationProperties.Name="{Binding PaneActionsLabel}"
                  ToolTip.Tip="{Binding PaneActionsLabel}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <TextBlock Classes="caption" Text="{Binding PaneActionsLabel}"/>
              <LucideIcon Kind="ChevronDown" Size="{StaticResource IconSizeSm}"/>
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{Binding SplitRightLabel}" Command="{Binding SplitRightCommand}">
                  <MenuItem.Icon>
                    <LucideIcon Kind="PanelRight" Size="{StaticResource IconSizeSm}"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding SplitBelowLabel}" Command="{Binding SplitBelowCommand}">
                  <MenuItem.Icon>
                    <LucideIcon Kind="PanelBottom" Size="{StaticResource IconSizeSm}"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding ShowConnectionBarLabel}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowConnectionBar, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="{Binding MoveOrSwapLabel}"
                          IsEnabled="{Binding HasMoveTargets}"
                          ItemsSource="{Binding MoveTargets}">
                  <MenuItem.ItemTemplate>
                    <DataTemplate DataType="vm:PaneMoveTarget">
                      <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                  </MenuItem.ItemTemplate>
                  <MenuItem.Styles>
                    <!--
                      A target pane is a submenu of its own: swap with it, or dock on one of its
                      four edges. Bound through a container style because the items come from the
                      view model two levels down, which an ItemTemplate alone cannot reach.
                    -->
                    <Style Selector="MenuItem > MenuItem" x:DataType="vm:PaneMoveTarget">
                      <Setter Property="ItemsSource" Value="{Binding Options}"/>
                    </Style>
                    <Style Selector="MenuItem > MenuItem > MenuItem" x:DataType="vm:PaneMoveOption">
                      <Setter Property="Header" Value="{Binding Title}"/>
                      <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                  </MenuItem.Styles>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding ClosePaneLabel}" Command="{Binding ClosePaneCommand}">
                  <MenuItem.Icon>
                    <LucideIcon Kind="X" Size="{StaticResource IconSizeSm}"/>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <!--
        The connection bar, as 1.x drew it (ui-reference 05): a chip naming what the pane is showing
        with its two badges, then how that connection is doing and the button that changes it. The
        badges are what let four panes on four different servers tell themselves apart at a glance,
        which is why the name alone was not enough.
      -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*"
            IsVisible="{Binding ShowConnectionBar}"
            ColumnSpacing="{StaticResource SpaceMd}"
            Margin="{StaticResource PaddingMd}">
        <Border Grid.Column="0" Classes="pane-chip">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
            <TextBlock Classes="pane-chip-name" Text="{Binding Title}"
                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                        IsVisible="{Binding HasBadges}" VerticalAlignment="Center">
              <Border Classes="pill primary">
                <TextBlock Text="{Binding TypeBadge}"/>
              </Border>
              <Border Classes="pill">
                <TextBlock Text="{Binding ProviderBadge}"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="pane-chip">
          <Grid ColumnDefinitions="*,280" ColumnSpacing="{StaticResource SpaceMd}">
            <TextBlock Grid.Column="0" Classes="pane-state" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ConnectionState}"
                       Classes.ready="{Binding ConnectionStateIsReady}"
                       Classes.busy="{Binding ConnectionStateIsBusy}"
                       Classes.failed="{Binding ConnectionStateIsFailed}"/>
            <!-- A button over a searchable picker rather than a drop-down list, which stops
                 scaling past a handful of connections. The picker is made fresh each time. -->
            <Button x:Name="PART_ConnectionButton" Grid.Column="1" Classes="picker"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding Title}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <LucideIcon Grid.Column="0" Kind="{Binding ConnectionIcon}"
                            Size="{StaticResource IconSizeSm}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <LucideIcon Grid.Column="2" Kind="ChevronDown"
                            Size="{StaticResource IconSizeSm}" VerticalAlignment="Center"/>
              </Grid>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <vm:ConnectionPickerView x:Name="PART_ConnectionPicker"/>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!--
        The file commands, labelled, under a FILES caption, as 1.x had them: New folder, then the
        three that move things between panes, then Delete, with the rest behind the overflow. Copy
        and move stage this pane's selection; paste puts what is staged into this pane - three
        buttons rather than two because a workspace can hold four panes, and "the other one" stops
        naming anything past two.
      -->
      <Border DockPanel.Dock="Top" Classes="pane-commands" IsVisible="{Binding IsListing}">
        <DockPanel>
          <!-- The named entries are shell commands, and show their shortcuts as 1.x's "..." did;
               the view reads the key as bound now each time the menu opens. -->
          <Button x:Name="PART_MoreCommands" DockPanel.Dock="Right" Classes="tool"
                  ToolTip.Tip="{Binding MoreFileCommandsLabel}"
                  AutomationProperties.Name="{Binding MoreFileCommandsLabel}">
            <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{Binding NewFileLabel}" Command="{Binding NewFileCommand}"
                          x:Name="PART_MoreNewFile">
                  <MenuItem.Icon><LucideIcon Kind="FilePlus" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding RenameLabel}" Command="{Binding RenameCommand}"
                          x:Name="PART_MoreRename">
                  <MenuItem.Icon><LucideIcon Kind="PencilLine" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding BatchRenameLabel}" Command="{Binding BatchRenameCommand}"
                          x:Name="PART_MoreBatchRename">
                  <MenuItem.Icon><LucideIcon Kind="ReplaceAll" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding EditLabel}" Command="{Binding EditCommand}">
                  <MenuItem.Icon><LucideIcon Kind="FilePen" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding SelectAllLabel}" Command="{Binding SelectAllCommand}"
                          x:Name="PART_MoreSelectAll">
                  <MenuItem.Icon><LucideIcon Kind="ListChecks" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding InvertSelectionLabel}" Command="{Binding InvertSelectionCommand}"
                          x:Name="PART_MoreInvertSelection">
                  <MenuItem.Icon><LucideIcon Kind="Replace" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding PropertiesLabel}" Command="{Binding PropertiesCommand}"
                          x:Name="PART_MoreProperties">
                  <MenuItem.Icon><LucideIcon Kind="Info" Size="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <TextBlock Classes="pane-caption" Text="{Binding FilesCaption}" VerticalAlignment="Center"/>
            <Border Classes="toolbar-separator"/>
            <Button Classes="tool" Command="{Binding NewFolderCommand}"
                    ToolTip.Tip="{Binding NewFolderLabel}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="FolderPlus" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding NewFolderLabel}"/>
              </StackPanel>
            </Button>
            <Border Classes="toolbar-separator"/>
            <Button Classes="tool" Command="{Binding CopyCommand}" ToolTip.Tip="{Binding CopyHint}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="Copy" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding CopyLabel}"/>
              </StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding MoveCommand}" ToolTip.Tip="{Binding MoveHint}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding MoveLabel}"/>
              </StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding PasteCommand}" ToolTip.Tip="{Binding PasteHint}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="ClipboardPaste" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding PasteLabel}"/>
              </StackPanel>
            </Button>
            <Border Classes="toolbar-separator"/>
            <Button Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="{Binding DeleteLabel}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="Trash" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding DeleteLabel}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!--
        Where the pane is, and what it is showing of it, on one row: back, forward and up, the
        address, refresh, then the filter under its own label. The filter narrows what is shown,
        not what was fetched, so clearing it costs nothing.
      -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="{StaticResource SpaceXs}"
            IsVisible="{Binding IsListing}"
            Margin="8,4">
        <Button Grid.Column="0" Classes="tool" Command="{Binding BackCommand}">
          <LucideIcon Kind="ArrowLeft" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <Button Grid.Column="1" Classes="tool" Command="{Binding ForwardCommand}">
          <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <Button Grid.Column="2" Classes="tool" Command="{Binding UpCommand}">
          <LucideIcon Kind="ArrowUp" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <TextBox x:Name="PART_Address" Grid.Column="3" Classes="dense"
                 Text="{Binding Address, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding Path}"
                 VerticalAlignment="Center"/>
        <Button Grid.Column="4" Classes="tool" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding RefreshLabel}">
          <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <TextBlock Grid.Column="5" Classes="muted" Text="{Binding FilterLabel}"
                   VerticalAlignment="Center" Margin="{StaticResource PaddingSm}"/>
        <TextBox Grid.Column="6" Classes="dense" Width="170" Text="{Binding Filter, Mode=TwoWay}"
                 Watermark="{Binding FilterPlaceholder}"
                 AutomationProperties.Name="{Binding FilterAccessibleName}"
                 VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <LucideIcon Kind="Search" Size="{StaticResource IconSizeSm}"
                        Margin="6,0,0,0" VerticalAlignment="Center"/>
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="7" Classes="tool" Command="{Binding ClearFilterCommand}"
                IsVisible="{Binding HasFilter}">
          <LucideIcon Kind="X" Size="{StaticResource IconSizeSm}"/>
        </Button>
      </Grid>

      <!-- "12 items" and what is selected, under the listing, as 1.x's pane footer read. -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*"
            ColumnSpacing="{StaticResource SpaceLg}"
            IsVisible="{Binding IsListing}"
            Margin="8,4">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
          <TextBlock Classes="muted" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
          <Button Classes="link" Content="{Binding LoadMoreLabel}" Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding HasMorePages}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectionSummary}" VerticalAlignment="Center"/>
      </Grid>

      <!--
        What the pane has to say, above the list as 1.x's banner was: a failure in the warning
        colour, clickable to try again, and a note (landing on the nearest folder that exists)
        quietly. A restored pane waiting to be connected is a note that can be clicked. It sits
        over nothing: a failed navigation keeps the listing somebody was looking at, so a typo in
        a path costs nothing to recover from.
      -->
      <Button DockPanel.Dock="Top" Classes="pane-banner"
              Classes.warning="{Binding StatusIsWarning}"
              IsVisible="{Binding HasStatus}"
              IsHitTestVisible="{Binding BannerIsClickable}"
              Command="{Binding RetryCommand}"
              ToolTip.Tip="{Binding RetryHint}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
          <LucideIcon Kind="TriangleAlert" Size="{StaticResource IconSizeSm}" Classes="warning"
                      IsVisible="{Binding StatusIsWarning}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </StackPanel>
      </Button>

      <!--
        The body is whichever of the two a pane is: a listing, or a terminal. Both live under the
        same chrome, so pointing a pane at an SSH client and back is the same gesture as switching
        between two buckets - which is what the connection picker above already implies.
      -->
      <Panel>
        <!--
          The folder tree beside the list, as 1.x had it: the pane's root, the way down to where
          the pane is, and the folders around it that have been listed. Choosing one goes there.
        -->
        <Grid ColumnDefinitions="185,Auto,*" IsVisible="{Binding IsListing}">
          <!-- No sideways scrolling: a deep folder would scroll the tree left until the top of
               the path was out of sight. Names past the edge end in an ellipsis instead. -->
          <TreeView x:Name="PART_Tree" Grid.Column="0" Classes="pane-tree"
                    ItemsSource="{Binding Tree.Roots}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="{Binding Title}">
            <TreeView.Resources>
              <x:Double x:Key="TreeViewItemIndent">12</x:Double>
              <x:Double x:Key="TreeViewItemMinHeight">22</x:Double>
              <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{DynamicResource SelectionColor}"/>
              <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{DynamicResource SelectionColor}"/>
              <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{DynamicResource TextColor}"/>
              <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="{DynamicResource TextColor}"/>
            </TreeView.Resources>
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:PaneTreeNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:PaneTreeNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Target}">
                  <LucideIcon Kind="{Binding Icon}" Size="16" Classes.folder="{Binding !IsRoot}"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <GridSplitter Grid.Column="1" Width="{StaticResource SplitterThickness}"
                        ResizeDirection="Columns"/>
          <Panel Grid.Column="2">
            <TableView x:Name="PART_Rows"
                       ItemsSource="{Binding Rows}"
                       IsVisible="{Binding IsListing}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}"
                       SelectedItems="{Binding SelectedRows}"
                       SelectionMode="Multiple">
              <!-- There from the start and filled as it opens. A menu first given to the list by
                   the request that should open it is not opened by that request, so the first
                   right-click, and the Menu key, did nothing. -->
              <TableView.ContextMenu>
                <ContextMenu/>
              </TableView.ContextMenu>
              <!--
                Five columns, the same five 1.x showed. The headings carry the sort arrow and are set
                from the view model in code-behind: a TableViewColumn is not in the visual tree, so it
                has no DataContext for a binding to walk.
              -->
              <TableView.Columns>
                <!--
                  Narrow enough that the name still has room in a quarter-width pane. A star column
                  gets what the fixed ones leave, so four columns sized for a full window leave the
                  name as an ellipsis in a four-pane workspace - which is the one column somebody is
                  actually reading.
                -->
                <TableViewColumn Width="*">
                  <!-- The name with its icon, as 1.x's list drew it: the system's own icon where
                       there is one, a glyph chosen from the extension where there is not. -->
                  <TableViewColumn.CellTemplate>
                    <DataTemplate DataType="core:BrowserListItem">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                          <Image Width="16" Height="16"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 Source="{Binding Converter={x:Static themes:FileSystemIconConverter.Instance}}"/>
                          <LucideIcon Size="16"
                                      Kind="{Binding Converter={x:Static themes:FileGlyphConverter.Instance}}"
                                      Classes.folder="{Binding Converter={x:Static themes:IsContainerRowConverter.Instance}}"
                                      IsVisible="{Binding Converter={x:Static themes:HasNoSystemIconConverter.Instance}}"/>
                        </Panel>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <!-- Right-aligned, as 1.x had it, so the digits of sizes line up. -->
                <TableViewColumn Width="80" HorizontalContentAlignment="Right">
                  <TableViewColumn.CellTemplate>
                    <DataTemplate DataType="core:BrowserListItem">
                      <TextBlock Text="{Binding Size}" TextAlignment="Right" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </DataTemplate>
                  </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Binding="{Binding Type}" Width="110"/>
                <TableViewColumn Binding="{Binding Modified}" Width="120"/>
                <TableViewColumn Binding="{Binding Status}" Width="90"/>
              </TableView.Columns>
            </TableView>

            <!-- The empty folder, said in the middle of the list rather than left blank. The
                 list underneath still takes a drop, so dragging into an empty folder works. -->
            <TextBlock Classes="muted" Text="{Binding EmptyNotice}" IsVisible="{Binding HasEmptyNotice}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- While a folder is read: the list is covered, so rows from the last one cannot be
                 acted on while they are about to be replaced. -->
            <Border Classes="pane-loading" IsVisible="{Binding ShowsLoading}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="{StaticResource SpaceSm}" Width="200"
                          AutomationProperties.Name="{Binding FetchingFolderLabel}">
                <TextBlock Text="{Binding FetchingFolderLabel}" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" MinHeight="4"/>
              </StackPanel>
            </Border>
          </Panel>
        </Grid>

        <!--
          The SSH surface. TerminalView paints the screen buffer the emulator maintains and sends
          what is typed at it back to the session; everything a terminal pane needs from the
          workspace - being the active pane, being refused as a transfer endpoint, surviving a
          layout change - is settled by the pane around it.
        -->
        <Panel IsVisible="{Binding IsTerminal}">
          <!--
            The painter fills the surface itself, so the border is here for its shape rather than
            its colour: clipped to the same radius as the listing beside it, or a terminal pane is
            the one square-cornered rectangle in a window of rounded ones.
          -->
          <Border Classes="terminal" IsVisible="{Binding HasTerminal}"
                  CornerRadius="{StaticResource FieldRadius}" ClipToBounds="True">
            <!-- The scroll bar is the viewer's; the painter drives it in lines through
                 ILogicalScrollable, so the thumb is the screen's share of the scrollback. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <vm:TerminalView Session="{Binding Terminal}"
                               FontFamilyName="{Binding TerminalFontFamily}"
                               FontSize="{Binding TerminalFontSize}"
                               RenderBoldText="{Binding TerminalRenderBoldText}"
                               AutomationProperties.Name="{Binding TerminalOutputAccessibleName}"/>
            </ScrollViewer>
          </Border>

          <!-- What a terminal pane shows before it has a session: a connection has not been
               chosen yet, or the agent could not give it one. -->
          <Border Classes="terminal" IsVisible="{Binding !HasTerminal}"
                  Padding="{StaticResource PaddingLg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="{StaticResource SpaceSm}">
              <LucideIcon Kind="SquareTerminal" Size="{StaticResource IconSizeLg}"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center"/>
              <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding TerminalPending}"/>
              <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding TerminalConnectHint}"/>
            </StackPanel>
          </Border>
        </Panel>
      </Panel>

    </DockPanel>
  </Border>
</UserControl>
