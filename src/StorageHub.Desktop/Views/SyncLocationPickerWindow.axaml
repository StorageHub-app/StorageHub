<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
        x:Class="StorageHub.Desktop.Views.SyncLocationPickerWindow"
        x:DataType="vm:SyncLocationPickerModel"
        Title="{Binding Title}"
        AutomationProperties.Name="{Binding AccessibleTitle}"
        Width="{StaticResource SyncLocationPickerWindowWidth}" Height="{StaticResource SyncLocationPickerWindowHeight}"
        MinWidth="{StaticResource SyncLocationPickerWindowMinWidth}" MinHeight="{StaticResource SyncLocationPickerWindowMinHeight}"
        WindowStartupLocation="CenterOwner">

  <!--
    One connection's folders, one level at a time. Double-click or Enter opens a folder; "Select
    this folder" chooses the one being shown, not the one highlighted, so what is chosen is always
    a folder that was just listed.
  -->

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="surface" Padding="{StaticResource PickerHeaderPadding}">
      <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Classes="heading" Text="{Binding Heading}"/>
        <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="{StaticResource SpaceSm}" Margin="{StaticResource PickerAddressMargin}">
      <Button Grid.Column="0" Command="{Binding UpCommand}" ToolTip.Tip="{Binding UpLabel}"
              AutomationProperties.Name="{Binding UpLabel}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
          <LucideIcon Kind="ArrowUp" Size="{StaticResource IconSizeXs}"/>
          <TextBlock Text="{Binding UpLabel}"/>
        </StackPanel>
      </Button>
      <TextBox Grid.Column="1" Text="{Binding Address, Mode=TwoWay}"
               PlaceholderText="{Binding AddressPlaceholder}"
               AutomationProperties.Name="{Binding AddressAccessibleName}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding GoCommand}"/>
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="2" Content="{Binding RootLabel}" Command="{Binding RootCommand}"/>
      <Button Grid.Column="3" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"/>
    </Grid>

    <Border DockPanel.Dock="Bottom" Classes="surface" Padding="{StaticResource DialogFooterPadding}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
        <TextBlock Grid.Column="0" Classes="status" VerticalAlignment="Center"
                   Classes.danger="{Binding Status.IsDanger}"
                   Text="{Binding Status.Text}" TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding StatusAccessibleName}"/>
        <Button Grid.Column="1" Content="{Binding LoadMoreLabel}" Command="{Binding LoadMoreCommand}"/>
        <Button Grid.Column="2" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsCancel="True"/>
        <Button Grid.Column="3" Classes="primary" Content="{Binding SelectLabel}"
                Command="{Binding SelectCommand}" IsDefault="True"/>
      </Grid>
    </Border>

    <ListBox ItemsSource="{Binding Folders}"
             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
             Margin="{StaticResource PickerListMargin}"
             DoubleTapped="FolderDoubleTapped"
             AutomationProperties.Name="{Binding FoldersAccessibleName}">
      <ListBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}"/>
      </ListBox.KeyBindings>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="core:SyncLocationFolder">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
            <LucideIcon Kind="Folder" Size="{StaticResource IconSizeSm}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding RelativePath}"
                       VerticalAlignment="Center" MaxWidth="{StaticResource PickerPathMaxWidth}" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
