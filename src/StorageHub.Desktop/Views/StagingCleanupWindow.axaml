<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.StagingCleanupWindow"
        x:DataType="vm:StagingCleanupModel"
        Title="{x:Static vm:StagingCleanupModel.Title}"
        Width="960" Height="540"
        MinWidth="720" MinHeight="380"
        WindowStartupLocation="CenterOwner">

  <!--
    What this is for, said once at the top; the search options; every leftover with its size and
    whether it can go; and the removal at the bottom on the danger style, because nothing removed
    here comes back. In-use rows sort last and say so, so a selection that includes them is easy to
    understand when they stay.
  -->

  <Border Classes="surface">
    <DockPanel Margin="{StaticResource PaddingLg}">

      <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{x:Static vm:StagingCleanupModel.Intro}"
                 TextWrapping="Wrap" Margin="0,0,0,8"/>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{StaticResource SpaceSm}" Margin="0,0,0,8">
        <CheckBox Grid.Column="0" Content="{x:Static vm:StagingCleanupModel.IncludeRemoteLabel}"
                  IsChecked="{Binding IncludeRemote, Mode=TwoWay}"/>
        <Button Grid.Column="2" Content="{x:Static vm:StagingCleanupModel.SearchLabel}"
                Command="{Binding SearchCommand}"/>
      </Grid>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="{StaticResource SpaceSm}" Margin="0,8,0,0">
        <TextBlock Grid.Column="0" Classes="status"
                   Classes.primary="{Binding Status.IsPrimary}"
                   Classes.success="{Binding Status.IsSuccess}"
                   Classes.warning="{Binding Status.IsWarning}"
                   Classes.danger="{Binding Status.IsDanger}"
                   Text="{Binding Status.Text}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="danger" Content="{x:Static vm:StagingCleanupModel.RemoveLabel}"
                Command="{Binding RemoveCommand}"/>
        <Button Grid.Column="2" Content="{x:Static vm:StagingCleanupModel.CloseLabel}"
                Click="OnClose" IsCancel="True"/>
      </Grid>

      <TableView ItemsSource="{Binding Rows}"
                 SelectedItems="{Binding SelectedRows}"
                 SelectionMode="Multiple"
                 AutomationProperties.Name="{x:Static vm:StagingCleanupModel.Title}">
        <TableView.Columns>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnName}" Binding="{Binding Name}" Width="230*"/>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnKind}" Binding="{Binding Kind}" Width="140"/>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnFolder}" Binding="{Binding Folder}" Width="260*"/>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnSize}" Binding="{Binding Size}" Width="90"/>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnModified}" Binding="{Binding Modified}" Width="140"/>
          <TableViewColumn Header="{x:Static vm:StagingCleanupModel.ColumnState}" Width="120">
            <TableViewColumn.CellTemplate>
              <DataTemplate DataType="vm:LeftoverRow">
                <TextBlock Classes="status" Classes.warning="{Binding InUse}"
                           Text="{Binding State}" VerticalAlignment="Center"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>
        </TableView.Columns>
      </TableView>
    </DockPanel>
  </Border>
</Window>
