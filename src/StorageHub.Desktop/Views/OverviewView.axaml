<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             x:Class="StorageHub.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewModel">

  <!--
    The Welcome tab. Compare against docs/ui-reference/01-welcome-overview.png; every number below
    is a token, so this is the same layout at every scaling on both platforms.
  -->

  <ScrollViewer>
    <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SpaceXl}">

      <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Classes="heading" Text="{Binding Headline}"/>
        <TextBlock Classes="muted" Text="{Binding Subheading}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
        <Button Classes="primary" Content="{Binding NewWorkspaceLabel}" Command="{Binding NewWorkspaceCommand}"/>
        <Button Command="{Binding ConnectionsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="Network" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding ConnectionsLabel}"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding SyncTasksCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="ArrowLeftRight" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding SyncTasksLabel}"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding RefreshLabel}"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Four cards across, each keeping its share of the width at any window size. -->
      <ItemsControl ItemsSource="{Binding Metrics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:MetricCard">
            <Border Classes="metric"
                    Classes.primary="{Binding IsPrimary}"
                    Classes.success="{Binding IsSuccess}"
                    Classes.warning="{Binding IsWarning}"
                    Classes.danger="{Binding IsDanger}"
                    Margin="{StaticResource PaddingSm}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeXl}"
                            VerticalAlignment="Center"
                            Classes.primary="{Binding IsPrimary}"
                            Classes.success="{Binding IsSuccess}"
                            Classes.warning="{Binding IsWarning}"
                            Classes.danger="{Binding IsDanger}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Classes="metric-value" Text="{Binding Value}"
                             Classes.primary="{Binding IsPrimary}"
                             Classes.success="{Binding IsSuccess}"
                             Classes.warning="{Binding IsWarning}"
                             Classes.danger="{Binding IsDanger}"/>
                  <TextBlock Classes="caption" Text="{Binding Caption}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="section">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                      Spacing="{StaticResource SpaceMd}" Margin="{StaticResource PaddingMd}">
            <LucideIcon Kind="Plus" Size="{StaticResource IconSizeLg}" Classes="primary"
                        VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Classes="title" Text="{Binding WorkspacesTitle}"/>
              <TextBlock Classes="caption" Text="{Binding WorkspacesSubtitle}"/>
            </StackPanel>
          </StackPanel>
          <!--
            Pinned first, then recent, as 1.x listed them. A double-click or Enter opens one, and
            the right-click menu is 1.x's: Open, Pin or Unpin, Remove from list, Copy path. A file
            that has gone is dimmed rather than disabled, since opening it is what offers to take
            it off the list. Name and Location are 1.x's widths, and State takes what is left.
          -->
          <TableView x:Name="PART_Workspaces" ItemsSource="{Binding Workspaces}" Height="140"
                     SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}">
            <TableView.ContextMenu>
              <ContextMenu x:Name="PART_WorkspaceMenu">
                <MenuItem Header="{Binding OpenWorkspaceLabel}" Command="{Binding OpenWorkspaceCommand}"/>
                <MenuItem Header="{Binding PinWorkspaceLabel}" Command="{Binding ToggleWorkspacePinCommand}"/>
                <MenuItem Header="{Binding ForgetWorkspaceLabel}" Command="{Binding ForgetWorkspaceCommand}"/>
                <MenuItem Header="{Binding CopyWorkspacePathLabel}" Command="{Binding CopyWorkspacePathCommand}"/>
              </ContextMenu>
            </TableView.ContextMenu>
            <TableView.Columns>
              <TableViewColumn Header="{Binding ColumnName}" Width="176">
                <TableViewColumn.CellTemplate>
                  <DataTemplate DataType="vm:WorkspaceRow">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                ToolTip.Tip="{Binding ToolTip}">
                      <LucideIcon Kind="{Binding Icon.Kind}" Size="{StaticResource IconSizeSm}"
                                  VerticalAlignment="Center"
                                  Classes.primary="{Binding Icon.IsPrimary}"
                                  Classes.warning="{Binding Icon.IsWarning}"/>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsMissing}"/>
                    </StackPanel>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="{Binding ColumnLocation}" Width="336">
                <TableViewColumn.CellTemplate>
                  <DataTemplate DataType="vm:WorkspaceRow">
                    <TextBlock Text="{Binding Location}" VerticalAlignment="Center" ToolTip.Tip="{Binding ToolTip}"
                               TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsMissing}"/>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="{Binding ColumnState}" Width="*">
                <TableViewColumn.CellTemplate>
                  <DataTemplate DataType="vm:WorkspaceRow">
                    <TextBlock Text="{Binding State}" VerticalAlignment="Center"
                               Classes.muted="{Binding IsMissing}"/>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
            </TableView.Columns>
          </TableView>
        </DockPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto,*">
        <Border Grid.Column="0" Classes="section">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                        Spacing="{StaticResource SpaceMd}" Margin="{StaticResource PaddingMd}">
              <LucideIcon Kind="Network" Size="{StaticResource IconSizeLg}" Classes="primary"
                          VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Classes="title" Text="{Binding ConnectionsTitle}"/>
                <TextBlock Classes="caption" Text="{Binding ConnectionsSubtitle}"/>
              </StackPanel>
            </StackPanel>
            <TableView ItemsSource="{Binding RecentConnections}" Height="140">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnName}" Width="*">
                  <TableViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:RecentConnectionRow">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <LucideIcon Kind="{Binding Icon.Kind}" Size="{StaticResource IconSizeSm}"
                                    VerticalAlignment="Center" Classes.primary="{Binding Icon.IsPrimary}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="{Binding ColumnProvider}" Binding="{Binding Provider}" Width="120"/>
                <TableViewColumn Header="{Binding ColumnDetails}" Binding="{Binding Details}" Width="*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </Border>

        <Panel Grid.Column="1" Width="{StaticResource SpaceLg}"/>

        <Border Grid.Column="2" Classes="section">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                        Spacing="{StaticResource SpaceMd}" Margin="{StaticResource PaddingMd}">
              <LucideIcon Kind="TriangleAlert" Size="{StaticResource IconSizeLg}" Classes="warning"
                          VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Classes="title" Text="{Binding AttentionTitle}"/>
                <TextBlock Classes="caption" Text="{Binding AttentionSubtitle}"/>
              </StackPanel>
            </StackPanel>
            <TableView ItemsSource="{Binding Attention}" Height="140">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnName}" Width="*">
                  <TableViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:AttentionRow">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <LucideIcon Kind="{Binding Icon.Kind}" Size="{StaticResource IconSizeSm}"
                                    VerticalAlignment="Center"
                                    Classes.success="{Binding Icon.IsSuccess}"
                                    Classes.warning="{Binding Icon.IsWarning}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="{Binding ColumnState}" Binding="{Binding State}" Width="120"/>
                <TableViewColumn Header="{Binding ColumnUpdated}" Binding="{Binding Updated}" Width="*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
