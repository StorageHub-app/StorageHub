<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             x:Class="StorageHub.Desktop.Views.TransferQueueView"
             x:DataType="vm:TransferQueueModel">

  <!--
    The transfer queue, lifted out of MainWindow where it was drawn inline. Six of its tabs filter
    the same table by state; the seventh, Logs, shows the activity log instead, so each tab's
    content holds both and shows the one its tab asks for.

    The column headers were English literals here while this lived in MainWindow, although the
    WinForms queue read them from its strings; they are bound again.
  -->

  <DockPanel>
    <!-- The queue's own toolbar, above its tabs, exactly where TransferQueueControl put it. -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
          <!-- Each says in its tip what it acts on, as 1.x's did. -->
          <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding RefreshHint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
              <TextBlock Text="{Binding RefreshLabel}"/>
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding CancelCommand}" ToolTip.Tip="{Binding CancelHint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <LucideIcon Kind="Trash" Size="{StaticResource IconSizeSm}"/>
              <TextBlock Text="{Binding CancelLabel}"/>
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding RetryCommand}" ToolTip.Tip="{Binding RetryHint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <LucideIcon Kind="Play" Size="{StaticResource IconSizeSm}"/>
              <TextBlock Text="{Binding RetryLabel}"/>
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" Text="{Binding ReconcileLabel}"
                     VerticalAlignment="Center" Margin="{StaticResource PaddingLg}"/>
          <!-- As tall as the buttons beside it, as 1.x's was; Fluent's own field is a dialog's. -->
          <ComboBox Classes="dense" VerticalAlignment="Center"
                    ItemsSource="{Binding ReconcileActions}"
                    SelectedIndex="{Binding SelectedReconcileAction, Mode=TwoWay}"
                    MinWidth="150"/>
          <Button Classes="tool" Command="{Binding ApplyReconcileCommand}" ToolTip.Tip="{Binding ApplyHint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <LucideIcon Kind="CircleCheck" Size="{StaticResource IconSizeSm}"/>
              <TextBlock Text="{Binding ApplyLabel}"/>
            </StackPanel>
          </Button>
          <!-- The rows after these, as 1.x's Next was; Refresh comes back to the newest. -->
          <Button Classes="tool" Command="{Binding NextPageCommand}" ToolTip.Tip="{Binding NextHint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
              <TextBlock Text="{Binding NextLabel}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- In the column that stretches, so a narrow window trims it rather than pushing it
             off the edge; and clear of the edge, where the last word used to be cut. -->
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Message}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="12,0,8,0"
                   ToolTip.Tip="{Binding Message}"/>
      </Grid>
    </Border>

    <TabControl ItemsSource="{Binding Tabs}"
                SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="vm:TransferQueueTab">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding Title}"/>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="vm:TransferQueueTab">
          <Panel>
            <!-- Every state tab shows the same six columns over a different filter. Several rows
                 can be chosen, as in 1.x's grid, and the toolbar and the right-click menu act on
                 all of them. Only SelectedItems is bound: setting a SelectedItem back would
                 collapse a selection of several to one.

                 It does not scroll to the selection by itself. Each poll moves the transfer that
                 changed last to the top, which shifts the chosen rows, and the table scrolled
                 back to them twice a second while somebody was scrolling down to pick another.
                 The arrow keys still bring the row they move to into view. -->
            <TableView IsVisible="{Binding IsStateFilter}"
                       ItemsSource="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).Rows}"
                       SelectedItems="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).SelectedRows}"
                       SelectionMode="Multiple"
                       AutoScrollToSelectedItem="False">
              <!-- There from the start and filled as it opens. A menu first given to the table by
                   the request that should open it is not opened by that request, so the first
                   right-click, and the Menu key, did nothing. -->
              <TableView.ContextMenu>
                <ContextMenu/>
              </TableView.ContextMenu>
              <TableView.Columns>
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnOperation}"
                                 Binding="{Binding Operation}" Width="140"/>
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnSource}"
                                 Binding="{Binding Source}" Width="*"/>
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnDestination}"
                                 Binding="{Binding Destination}" Width="*"/>
                <!-- A bar behind the text, as 1.x's TransferProgressColumn drew it. The text stays
                     the value a screen reader reads; a transfer of unknown size has no bar. -->
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnProgress}"
                                 Width="160">
                  <TableViewColumn.CellTemplate>
                    <DataTemplate DataType="vm:TransferRow">
                      <Panel Margin="0,3">
                        <!-- Hidden by opacity rather than removed, so a row with no bar is as wide as
                             one with a bar and its text is centred the same way. -->
                        <ProgressBar Classes="transfer"
                                     Classes.none="{Binding !HasProgressBar}"
                                     Classes.complete="{Binding IsComplete}"
                                     Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
                        <TextBlock Text="{Binding Progress}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Panel>
                    </DataTemplate>
                  </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnAttempt}"
                                 Binding="{Binding Attempt}" Width="90"/>
                <TableViewColumn Header="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).ColumnStatus}"
                                 Binding="{Binding Status}" Width="160"/>
              </TableView.Columns>
            </TableView>

            <!-- Wrapped, so its visibility is read from the tab: the log view's own DataContext
                 is the log, and a binding on the same element would be resolved against that. -->
            <Panel IsVisible="{Binding IsLog}">
              <vm:ActivityLogView
                  DataContext="{Binding $parent[vm:TransferQueueView].((vm:TransferQueueModel)DataContext).Activity}"/>
            </Panel>
          </Panel>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
