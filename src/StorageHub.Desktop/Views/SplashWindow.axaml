<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.SplashWindow"
        x:DataType="vm:SplashModel"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

  <!--
    The splash, as 1.x's was: the mark, the name and the version, then the step the shell is on
    with a moving bar under it. When a step fails the bar gives way to what went wrong and what can
    be done about it: Quit, Copy details, and Retry for the steps worth retrying.
  -->

  <Border Classes="splash">
    <StackPanel Spacing="{StaticResource SpaceSm}" HorizontalAlignment="Stretch">
      <Image Source="avares://StorageHub.Desktop/Assets/storagehub-icon.png"
             Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,6"/>
      <TextBlock Classes="splash-title" Text="{Binding Title}" HorizontalAlignment="Center"/>
      <TextBlock Classes="muted" Text="{Binding Version}" HorizontalAlignment="Center"
                 Margin="0,0,0,12"/>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center"
                 Classes.danger="{Binding IsFailed}"
                 AutomationProperties.Name="Startup status"/>
      <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap"
                 TextAlignment="Center" IsVisible="{Binding HasDetails}"
                 AutomationProperties.Name="Startup details"/>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsWorking}"
                   Margin="0,10,0,0" MinHeight="4"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                  Spacing="{StaticResource SpaceSm}" Margin="0,12,0,0"
                  IsVisible="{Binding IsFailed}">
        <Button Content="{Binding QuitLabel}" Command="{Binding QuitCommand}"/>
        <Button Content="{Binding CopyDetailsLabel}" Command="{Binding CopyDetailsCommand}"/>
        <Button Classes="primary" Content="{Binding RetryLabel}" Command="{Binding RetryCommand}"
                IsVisible="{Binding CanRetry}" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
