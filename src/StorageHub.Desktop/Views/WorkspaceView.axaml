<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             x:Class="StorageHub.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceModel">

  <!--
    The panes of a workspace, in whichever of the six arrangements is showing.

    There is no pane markup here because the arrangement is a tree and XAML cannot draw a tree of
    unknown depth. The code-behind walks the same WorkspaceLayoutModel that Desktop.Core already
    saves, splits and tests, turning each split into a two-column or two-row grid and each leaf
    into a BrowserPaneView. That walk is fifty lines and is the only layout code in the shell.
  -->

  <!--
    Scrolls only when the window cannot be made big enough for every pane at its minimum, as a
    small screen with four panes can be: the panes keep their chrome and the area scrolls, rather
    than the panes being squeezed until the last one slides under the transfer queue. The host is
    sized to the larger of the room and that minimum by the code-behind (docs/ui-rules.md, Layout).
  -->
  <ScrollViewer Name="PART_Scroller"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Panel Name="PART_Host"/>
  </ScrollViewer>
</UserControl>
