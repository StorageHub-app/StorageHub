<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
             x:Class="StorageHub.Desktop.Views.ConnectionsPanelView"
             x:DataType="vm:ConnectionsSidebar">

  <!--
    The connections panel: groups somebody made, each holding connections, each connection wearing
    a badge saying what kind of thing it is.

    Its own view rather than markup inside the window, because everything about how connections are
    organised now happens here - making a group, renaming one, dragging a connection between them -
    and because a panel that can be shown on its own is a panel a test can photograph with
    connections in it.
  -->

  <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
            Margin="{StaticResource PaddingLg}">
        <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="Plus" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding NewLabel}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="tool" Margin="{StaticResource PaddingSm}"
                ToolTip.Tip="{Binding MoreLabel}">
          <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{Binding NewGroupLabel}"
                        Command="{Binding NewGroupCommand}">
                <MenuItem.Icon>
                  <LucideIcon Kind="FolderPlus" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{Binding ManageLabel}" Command="{Binding ManageCommand}">
                <MenuItem.Icon>
                  <LucideIcon Kind="Settings" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
  
      <!-- The search box carries its own glyph, as the owner-drawn field did. It had no Text
           binding at all until now, which made it decoration: it accepted typing and nothing
           read it. -->
      <Grid DockPanel.Dock="Top" Margin="12,0,12,0">
        <TextBox Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 Padding="30,8,32,8"/>
        <Button Classes="tool" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,4,0"
                IsVisible="{Binding HasSearch}"
                Command="{Binding ClearSearchCommand}"
                ToolTip.Tip="{Binding ClearSearchLabel}">
          <LucideIcon Kind="X" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <LucideIcon Kind="Search" Size="{StaticResource IconSizeSm}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="{StaticResource PaddingLg}"/>
      </Grid>
  
      <!-- Details for the selected connection, below its own rule. Empty until one is picked,
           which is the state the shell spends most of its life in. -->
      <Border DockPanel.Dock="Bottom" Height="200"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              Padding="{StaticResource PaddingLg}">
        <TextBlock Classes="muted" Text="{Binding DetailPlaceholder}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
  
      <Panel Margin="12,12,12,0">
        <TextBlock Classes="muted" Text="{Binding Status}"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   IsVisible="{Binding IsEmpty}"/>
        <!--
          Groups somebody made, rather than the Storage and Clients split 1.x had. That split
          was the provider's classification standing in for an organising principle: four
          buckets and two shells for one project belong together, and no amount of sorting
          inside two fixed lists gives that. The classification survives as a badge on the row,
          which is where it is actually useful.
        -->
        <ScrollViewer x:Name="PART_Connections" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource SpaceMd}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConnectionGroupModel">
                <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
  
                  <Grid ColumnDefinitions="Auto,*,Auto" Classes="group-header"
                        ColumnSpacing="{StaticResource SpaceXs}">
                    <ToggleButton Grid.Column="0" Classes="disclosure"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" Classes="group-title" VerticalAlignment="Center"
                               Text="{Binding Name}"/>
                    <Button Grid.Column="2" Classes="tool"
                            ToolTip.Tip="{Binding RenameLabel}">
                      <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{Binding RenameLabel}" Command="{Binding RenameCommand}"/>
                          <MenuItem Header="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"/>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
  
                  <!--
                    The drop target is the whole group, including an empty one: a group you
                    cannot drag the first connection into is a group you cannot start using.
                  -->
                  <ItemsControl ItemsSource="{Binding Connections}"
                                IsVisible="{Binding IsExpanded}"
                                MinHeight="24">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource SpaceXs}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ConnectionRowModel">
                        <Border Classes="card connection-row" Classes.disabled="{Binding !IsEnabled}"
                                ToolTip.Tip="{Binding OpenHint}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Border Grid.Column="0" Classes="badge"
                                    Classes.client="{Binding IsClient}"
                                    VerticalAlignment="Top">
                              <TextBlock Text="{Binding Badge}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}"/>
                              <TextBlock Classes="caption" Text="{Binding Endpoint}"/>
                              <TextBlock Classes="caption" Text="{Binding State}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
</UserControl>
