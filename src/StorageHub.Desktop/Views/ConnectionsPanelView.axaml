<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
             x:Class="StorageHub.Desktop.Views.ConnectionsPanelView"
             x:DataType="vm:ConnectionsSidebar">

  <!--
    The connections panel: groups somebody made, each holding connections, each connection wearing
    a badge saying what kind of thing it is.

    Its own view rather than markup inside the window, because everything about how connections are
    organised now happens here - making a group, renaming one, dragging a connection between them -
    and because a panel that can be shown on its own is a panel a test can photograph with
    connections in it.
  -->

  <!--
    The favourite mark: a filled star, as 1.x drew it before Favorites and before a favourite's
    name in the details (ui-reference 09). Lucide's star is an outline that cannot be filled, so
    both marks draw this one shape and cannot drift apart.
  -->
  <UserControl.Resources>
    <StreamGeometry x:Key="FavoriteMark">M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z</StreamGeometry>
  </UserControl.Resources>

  <!--
    One group and its cards. A template of the panel's own rather than the list's, because
    Favorites above the list is drawn by it too; Favorites has no menu, being nobody's group.
  -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ConnectionGroupModel">
      <StackPanel AutomationProperties.Name="{Binding AccessibleName}">

        <!-- Painted, if only with nothing, so a right-click anywhere along the heading reaches it
             and opens the icon picker, as 1.x's heading did, not only one on its name. -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Classes="group-header"
              Background="Transparent"
              ColumnSpacing="{StaticResource SpaceXs}">
          <ToggleButton Grid.Column="0" Classes="disclosure"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
          <LucideIcon Grid.Column="1" Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"
                      VerticalAlignment="Center" IsVisible="{Binding !IsFavorites}"/>
          <PathIcon Grid.Column="1" Data="{StaticResource FavoriteMark}"
                    Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                    IsVisible="{Binding IsFavorites}"/>
          <TextBlock Grid.Column="2" Classes="group-title" VerticalAlignment="Center"
                     Text="{Binding Name}"/>
          <Button Grid.Column="3" Classes="tool" IsVisible="{Binding !IsFavorites}"
                  ToolTip.Tip="{Binding RenameLabel}">
            <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{Binding RenameLabel}" Command="{Binding RenameCommand}"/>
                <MenuItem Header="{Binding ChangeIconLabel}" Command="{Binding ChangeIconCommand}"/>
                <MenuItem Header="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <!--
          The drop target is the whole group, including an empty one: a group you
          cannot drag the first connection into is a group you cannot start using.
        -->
        <ItemsControl ItemsSource="{Binding Connections}"
                      IsVisible="{Binding IsExpanded}"
                      MinHeight="24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{StaticResource SpaceXs}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ConnectionRowModel">
              <!--
                A card as 1.x drew it (ui-reference 09): a rounded tile in the
                connection's colour with its icon, the name, a muted line of provider,
                folder and health, and its tags as chips. The selected card takes the
                accent border and shows edit and delete beside it.
              -->
              <vm:ConnectionCard Classes="card connection-row" Classes.disabled="{Binding !IsEnabled}"
                                 Classes.selected="{Binding IsSelected}"
                                 ToolTip.Tip="{Binding OpenHint}">
                <!-- There from the start and filled as it opens, as the pane's list is. A menu
                     first given to the card by the right-click that should open it is not opened
                     by that right-click. -->
                <vm:ConnectionCard.ContextMenu>
                  <ContextMenu/>
                </vm:ConnectionCard.ContextMenu>
                <!-- The name has the card's whole width, and edit and delete sit at the end of the
                     second line, as 1.4 drew them (ui-reference 09). In a column of their own
                     beside the name they took its room, so a selected card's name was cut short
                     with space left around the two icons. -->
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                      ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceXs}">
                  <Border Grid.Column="0" Grid.RowSpan="2" Classes="icon-tile" Background="{Binding AccentBrush}"
                          VerticalAlignment="Top">
                    <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeMd}"/>
                  </Border>
                  <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Endpoint}"/>
                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}"
                                  Margin="0,2,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="4" LineSpacing="4"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Classes="tag">
                            <TextBlock Text="{Binding}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top"
                              Margin="{StaticResource CardActionOutset}" Spacing="{StaticResource SpaceXs}"
                              IsVisible="{Binding IsSelected}">
                    <Button Classes="tool" Padding="{StaticResource CardActionPadding}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsSidebar)DataContext).EditSelectedCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ConnectionsSidebar)DataContext).EditLabel}">
                      <LucideIcon Kind="Pencil" Size="{StaticResource IconSizeSm}"/>
                    </Button>
                    <Button Classes="tool" Padding="{StaticResource CardActionPadding}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsSidebar)DataContext).DeleteSelectedCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ConnectionsSidebar)DataContext).DeleteLabel}">
                      <LucideIcon Kind="Trash" Size="{StaticResource IconSizeSm}" Classes="danger"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </vm:ConnectionCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
            Margin="{StaticResource PaddingLg}">
        <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="Plus" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding NewLabel}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="tool" Margin="{StaticResource PaddingSm}"
                ToolTip.Tip="{Binding MoreLabel}">
          <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{Binding NewGroupLabel}"
                        Command="{Binding NewGroupCommand}">
                <MenuItem.Icon>
                  <LucideIcon Kind="FolderPlus" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
              <!-- 1.x's own three, in its order: move, refresh, and hide below a line. Move and
                   hide are the View menu's commands, so either route leaves the same layout. A
                   panel shown without the shell has no layout to change, and leaves them out.
                   There is no way into a list of connections from here, as there was none in 1.x:
                   this panel is that list, and New connection and Edit open the dialog for one. -->
              <Separator/>
              <MenuItem Header="{Binding MoveToOtherSideLabel}" Command="{Binding MoveToOtherSideCommand}"
                        IsVisible="{Binding MoveToOtherSideCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon>
                  <LucideIcon Kind="Layers" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding RefreshLabel}" Command="{Binding RefreshCommand}">
                <MenuItem.Icon>
                  <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator IsVisible="{Binding HidePanelCommand, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              <MenuItem Header="{Binding HidePanelLabel}" Command="{Binding HidePanelCommand}"
                        IsVisible="{Binding HidePanelCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon>
                  <LucideIcon Kind="EyeOff" Size="{StaticResource IconSizeSm}"/>
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
  
      <!-- The search box carries its own glyph, as the owner-drawn field did. It had no Text
           binding at all until now, which made it decoration: it accepted typing and nothing
           read it. -->
      <Grid DockPanel.Dock="Top" Margin="12,0,12,0">
        <TextBox Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 Padding="30,8,32,8"/>
        <Button Classes="tool" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,4,0"
                IsVisible="{Binding HasSearch}"
                Command="{Binding ClearSearchCommand}"
                ToolTip.Tip="{Binding ClearSearchLabel}">
          <LucideIcon Kind="X" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <LucideIcon Kind="Search" Size="{StaticResource IconSizeSm}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="{StaticResource PaddingLg}"/>
      </Grid>
  
      <!--
        Details for the selected connection, below its own rule, as 1.x's panel had them
        (ui-reference 09): a provider badge and the name, the connection's facts as key and value,
        and its actions, with Delete styled as the destructive one.
      -->
      <Border DockPanel.Dock="Bottom" Height="230"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              Padding="{StaticResource PaddingLg}">
        <Panel>
          <TextBlock Classes="muted" Text="{Binding DetailPlaceholder}"
                     IsVisible="{Binding !HasSelection}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <DockPanel IsVisible="{Binding HasSelection}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSm}" Margin="0,0,0,8">
              <Border Classes="detail-badge" Background="{Binding Selected.AccentBrush}">
                <TextBlock Text="{Binding Selected.Card.Descriptor.ShortName}"/>
              </Border>
              <!-- A star before a favourite's name, in the name's colour, as 1.x marked it: a
                   mark, not a button. Toggling is on the card's right-click menu. -->
              <PathIcon Data="{StaticResource FavoriteMark}"
                        Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                        Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                        IsVisible="{Binding Selected.IsFavorite, FallbackValue=False}"/>
              <TextBlock Classes="heading-sm" Text="{Binding Selected.Name}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>

            <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
              <Button Command="{Binding OpenSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                  <LucideIcon Kind="FolderOpen" Size="{StaticResource IconSizeSm}"/>
                  <TextBlock Text="{Binding OpenLabel}"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding TestSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                  <LucideIcon Kind="CircleCheck" Size="{StaticResource IconSizeSm}"/>
                  <TextBlock Text="{Binding TestLabel}"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding EditSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                  <LucideIcon Kind="Pencil" Size="{StaticResource IconSizeSm}"/>
                  <TextBlock Text="{Binding EditLabel}"/>
                </StackPanel>
              </Button>
              <Button Classes="danger" Command="{Binding DeleteSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                  <LucideIcon Kind="Trash" Size="{StaticResource IconSizeSm}"/>
                  <TextBlock Text="{Binding DeleteLabel}"/>
                </StackPanel>
              </Button>
            </WrapPanel>

            <!-- Above the actions, in the warning colour, as 1.x's was: "Fix credentials…" or
                 "Review trust…" when the last check found one, opening the editor on the tab
                 that fixes it. -->
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    IsVisible="{Binding HasAttention}" Command="{Binding AttentionCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="TriangleAlert" Size="{StaticResource IconSizeSm}" Classes="warning"/>
                <TextBlock Classes="warning" Text="{Binding AttentionLabel}"/>
              </StackPanel>
            </Button>

            <TextBlock DockPanel.Dock="Bottom" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding HasDetailStatus}" Text="{Binding DetailStatus}"/>

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <!-- 1.4's sections, a heading over the facts that belong to it: Server,
                       Authentication, Security, Transfer, Organisation, Status. -->
                  <DataTemplate DataType="vm:ConnectionDetailRow">
                    <Panel>
                      <TextBlock Classes="detail-section" Text="{Binding Key}"
                                 IsVisible="{Binding IsSection}"/>
                      <Grid ColumnSpacing="{StaticResource SpaceSm}" Classes="detail-row"
                            IsVisible="{Binding IsFact}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{StaticResource DetailKeyWidth}"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Key}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}"/>
                      </Grid>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </Border>

      <Panel Margin="12,12,12,0">
        <TextBlock Classes="muted" Text="{Binding Status}"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   IsVisible="{Binding IsEmpty}"/>
        <!--
          Groups somebody made, rather than the Storage and Clients split 1.x had. That split
          was the provider's classification standing in for an organising principle: four
          buckets and two shells for one project belong together, and no amount of sorting
          inside two fixed lists gives that. The classification survives as a badge on the row,
          which is where it is actually useful.
        -->
        <ScrollViewer x:Name="PART_Connections" IsVisible="{Binding !IsEmpty}">
          <!-- Favorites above the groups, as 1.x listed them above its sections (ui-reference 09),
               drawn by the same template as a group and shown only while it has a card. -->
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <ContentControl Content="{Binding Favorites}"
                            IsVisible="{Binding Favorites, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource SpaceMd}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
</UserControl>
