<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.UnsafeEditWarningWindow"
        x:DataType="vm:UnsafeEditWarningModel"
        Title="{Binding Title}"
        Width="{StaticResource DialogMaxWidth}" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{Binding AccessibleName}">

  <!--
    Said before an edit whose upload cannot be held to the version that was downloaded. Cancel is
    the default: going ahead can overwrite somebody else's change, and a stray Enter should not.
  -->

  <DockPanel>
    <!-- The message box's footer band: the checkbox on its left, the buttons on its right. -->
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    Spacing="{StaticResource SpaceMd}">
          <Button Classes="dialog" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"/>
          <Button Classes="dialog primary" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                  IsDefault="True" IsCancel="True"/>
        </StackPanel>
        <CheckBox Margin="{StaticResource DialogFooterCheckBoxMargin}"
                  IsChecked="{Binding DontShowAgain, Mode=TwoWay}"
                  Content="{Binding DontShowAgainLabel}"
                  ToolTip.Tip="{Binding DontShowAgainHint}"/>
      </DockPanel>
    </Border>

    <Grid Margin="{StaticResource DialogContentPadding}" VerticalAlignment="Top"
          ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceLg}">
      <LucideIcon Grid.Column="0" Kind="TriangleAlert" Size="{StaticResource DialogIconSize}"
                  Classes="warning" VerticalAlignment="Top"/>
      <SelectableTextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
    </Grid>
  </DockPanel>
</Window>
