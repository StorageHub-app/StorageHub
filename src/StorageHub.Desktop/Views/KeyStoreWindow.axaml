<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.KeyStoreWindow"
        x:DataType="vm:KeyStoreModel"
        Title="{Binding Title}"
        Width="980" Height="560"
        MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner">

  <!--
    A toolbar, a table and a status line, as 1.x drew it. Import is primary because it is what
    the screen is for; Delete is on the danger style and at the far end of the row, because the
    material cannot be recovered afterwards and Rename is the button beside it.
  -->

  <Border Classes="surface">
    <DockPanel Margin="{StaticResource PaddingLg}">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,240"
            ColumnSpacing="{StaticResource SpaceSm}" Margin="0,0,0,8">
        <Button Grid.Column="0" Classes="primary" Content="{Binding ImportCertificateLabel}"
                Command="{Binding ImportCertificateCommand}"/>
        <Button Grid.Column="1" Content="{Binding ImportKeyLabel}"
                Command="{Binding ImportKeyCommand}"/>
        <Button Grid.Column="2" Content="{Binding RenameLabel}"
                Command="{Binding RenameCommand}"/>
        <Button Grid.Column="3" Classes="danger" Content="{Binding DeleteLabel}"
                Command="{Binding DeleteCommand}"/>
        <TextBox Grid.Column="5" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 AutomationProperties.Name="{Binding SearchAccessibleName}"/>
      </Grid>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <TextBlock Grid.Column="0" Classes="status"
                   Classes.primary="{Binding Status.IsPrimary}"
                   Classes.success="{Binding Status.IsSuccess}"
                   Classes.warning="{Binding Status.IsWarning}"
                   Classes.danger="{Binding Status.IsDanger}"
                   Text="{Binding Status.Text}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{Binding RefreshLabel}"
                Command="{Binding RefreshCommand}"/>
      </Grid>

      <TableView ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding ListAccessibleName}">
        <TableView.Columns>
          <!-- The identity is a subject or a fingerprint, and both are long. -->
          <TableViewColumn Header="{Binding ColumnName}" Binding="{Binding Name}" Width="200*"/>
          <TableViewColumn Header="{Binding ColumnKind}" Binding="{Binding Kind}" Width="110*"/>
          <TableViewColumn Header="{Binding ColumnIdentity}" Binding="{Binding Identity}" Width="260*"/>
          <!-- Coloured, because a certificate that silently breaks a connection when it passes
               is the thing this column exists to warn about. -->
          <TableViewColumn Header="{Binding ColumnExpires}" Width="130*">
            <TableViewColumn.CellTemplate>
              <DataTemplate DataType="vm:KeyStoreRow">
                <TextBlock Classes="status"
                           Classes.warning="{Binding IsExpiringSoon}"
                           Classes.danger="{Binding IsExpired}"
                           Text="{Binding Expires}" VerticalAlignment="Center"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>
          <TableViewColumn Header="{Binding ColumnUsedBy}" Binding="{Binding UsedBy}" Width="80"/>
          <TableViewColumn Header="{Binding ColumnTags}" Binding="{Binding Tags}" Width="140*"/>
        </TableView.Columns>
      </TableView>
    </DockPanel>
  </Border>
</Window>
