<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.KeyStorePickerWindow"
        x:DataType="vm:KeyStorePickerModel"
        Title="{Binding Title}"
        Width="820" Height="420"
        MinWidth="680" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <!--
    A list and a Use button, with the Key Store's own Import beside them, so a field whose key is
    not in the store yet is one dialog away from it rather than a trip to Connections, Key Store.
    Double-clicking a row is the same as Use. An empty store says so across the empty table,
    keeping its columns, where the entries would be.
  -->

  <Border Classes="surface">
    <DockPanel Margin="{StaticResource PaddingLg}">
      <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Hint}"
                 TextWrapping="Wrap" Margin="0,0,0,8"/>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="{StaticResource SpaceSm}" Margin="0,8,0,0">
        <Button Grid.Column="0" Content="{Binding ImportLabel}"
                Command="{Binding ImportCommand}"/>
        <TextBlock Grid.Column="1" Classes="status"
                   Classes.primary="{Binding Status.IsPrimary}"
                   Classes.success="{Binding Status.IsSuccess}"
                   Classes.warning="{Binding Status.IsWarning}"
                   Classes.danger="{Binding Status.IsDanger}"
                   Text="{Binding Status.Text}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"/>
        <Button Grid.Column="3" Classes="primary" Content="{Binding UseLabel}"
                IsDefault="True" Command="{Binding UseCommand}"/>
      </Grid>

      <Panel>
        <TableView x:Name="PART_Entries" ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   AutomationProperties.Name="{Binding ListAccessibleName}">
          <TableView.Columns>
            <TableViewColumn Header="{Binding ColumnName}" Binding="{Binding Name}" Width="200*"/>
            <!-- A certificate's subject or a key's fingerprint, which is how two keys with
                 similar names are told apart. -->
            <TableViewColumn Header="{Binding ColumnIdentity}" Binding="{Binding Identity}" Width="260*"/>
            <TableViewColumn Header="{Binding ColumnCreated}" Binding="{Binding Created}" Width="100*"/>
            <TableViewColumn Header="{Binding ColumnExpires}" Width="100*">
              <TableViewColumn.CellTemplate>
                <DataTemplate DataType="vm:KeyStorePickerRow">
                  <TextBlock Classes="status"
                             Classes.warning="{Binding IsExpiringSoon}"
                             Classes.danger="{Binding IsExpired}"
                             Text="{Binding Expires}" VerticalAlignment="Center"/>
                </DataTemplate>
              </TableViewColumn.CellTemplate>
            </TableViewColumn>
            <TableViewColumn Header="{Binding ColumnUsedBy}" Binding="{Binding UsedBy}" Width="70"/>
          </TableView.Columns>
        </TableView>
        <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{Binding EmptyMessage}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="{StaticResource PaddingLg}" IsHitTestVisible="False"/>
      </Panel>
    </DockPanel>
  </Border>
</Window>
