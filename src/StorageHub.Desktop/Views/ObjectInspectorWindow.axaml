<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.ObjectInspectorWindow"
        x:DataType="vm:ObjectInspectorModel"
        Title="{Binding Title}"
        Width="{StaticResource ObjectInspectorWindowWidth}" Height="{StaticResource ObjectInspectorWindowHeight}"
        MinWidth="{StaticResource ObjectInspectorWindowMinWidth}" MinHeight="{StaticResource ObjectInspectorWindowMinHeight}"
        WindowStartupLocation="CenterOwner">

  <!--
    A heading that says what is being looked at and what here can change it, four tabs, and a
    status line. General is the item's attributes and the two changes the connection may allow;
    the other three are a file's only and are hidden for a folder or a link. Each tab keeps its own
    notice because the sections fail independently: a provider that has versions and refuses tags
    shows the versions and says so under Tags.
  -->

  <Border Classes="surface">
    <DockPanel>

      <Border DockPanel.Dock="Top" Classes="toolbar" Padding="{StaticResource PaddingLg}">
        <StackPanel Spacing="{StaticResource SpaceXs}">
          <TextBlock Classes="title" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="{Binding PathAccessibleName}"/>
          <TextBlock Classes="muted" Text="{Binding Identity}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Classes="muted" Text="{Binding SafetyNotice}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding SafetyAccessibleName}"/>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Classes="statusbar" Padding="{StaticResource PaddingMd}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
          <TextBlock Grid.Column="0" Classes="status"
                     Classes.success="{Binding Status.IsSuccess}"
                     Classes.warning="{Binding Status.IsWarning}"
                     Classes.danger="{Binding Status.IsDanger}"
                     Text="{Binding Status.Text}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding StatusAccessibleName}"/>
          <Button Grid.Column="1" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"/>
          <Button Grid.Column="2" Content="{Binding CloseLabel}" Command="{Binding CloseCommand}"
                  IsCancel="True"/>
        </Grid>
      </Border>

      <TabControl Margin="{StaticResource PaddingLg}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding TabsAccessibleName}">
        <TabItem Header="{Binding GeneralTabLabel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="status"
                       Classes.warning="{Binding GeneralNotice.IsWarning}"
                       Text="{Binding GeneralNotice.Text}" TextWrapping="Wrap" Margin="{StaticResource GapAroundMd}"/>
            <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource GapAboveMd}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                          Spacing="{StaticResource SpaceSm}">
                <Button Content="{Binding ChangePermissionsLabel}" Command="{Binding ChangePermissionsCommand}"/>
                <Button Content="{Binding SetModifiedTimeLabel}" Command="{Binding SetModifiedTimeCommand}"/>
              </StackPanel>
              <TextBlock Classes="muted" HorizontalAlignment="Right" TextWrapping="Wrap"
                         IsVisible="{Binding HasChangesNotice}" Text="{Binding ChangesNotice}"/>
            </StackPanel>
            <TableView ItemsSource="{Binding General}"
                       AutomationProperties.Name="{Binding GeneralAccessibleName}">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnName}" Binding="{Binding Name}" Width="30*"/>
                <TableViewColumn Header="{Binding ColumnValue}" Binding="{Binding Value}" Width="70*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </TabItem>

        <TabItem Header="{Binding VersionsTabLabel}" IsVisible="{Binding IsFile}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="status"
                       Classes.warning="{Binding VersionsNotice.IsWarning}"
                       Text="{Binding VersionsNotice.Text}" TextWrapping="Wrap" Margin="{StaticResource GapAroundMd}"/>
            <Button DockPanel.Dock="Bottom" Content="{Binding LoadMoreLabel}"
                    Command="{Binding LoadMoreCommand}" HorizontalAlignment="Right"
                    Margin="{StaticResource GapAboveMd}"
                    AutomationProperties.Name="{Binding LoadMoreAccessibleName}"/>
            <TableView ItemsSource="{Binding Versions}"
                       AutomationProperties.Name="{Binding VersionsAccessibleName}">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnCurrent}" Binding="{Binding Current}" Width="{StaticResource InspectorCurrentColumnWidth}"/>
                <TableViewColumn Header="{Binding ColumnVersion}" Binding="{Binding VersionId}" Width="150*"/>
                <TableViewColumn Header="{Binding ColumnSize}" Binding="{Binding Size}" Width="{StaticResource SizeColumnWidth}"/>
                <TableViewColumn Header="{Binding ColumnModified}" Binding="{Binding Modified}" Width="{StaticResource InspectorModifiedColumnWidth}"/>
                <TableViewColumn Header="{Binding ColumnDeleteMarker}" Binding="{Binding DeleteMarker}" Width="{StaticResource InspectorDeleteMarkerColumnWidth}"/>
                <TableViewColumn Header="{Binding ColumnEntityTag}" Binding="{Binding EntityTag}" Width="120*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </TabItem>

        <TabItem Header="{Binding MetadataTabLabel}" IsVisible="{Binding IsFile}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="status"
                       Classes.warning="{Binding MetadataNotice.IsWarning}"
                       Text="{Binding MetadataNotice.Text}" TextWrapping="Wrap" Margin="{StaticResource GapAroundMd}"/>
            <TableView ItemsSource="{Binding Metadata}"
                       AutomationProperties.Name="{Binding MetadataAccessibleName}">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnName}" Binding="{Binding Name}" Width="35*"/>
                <TableViewColumn Header="{Binding ColumnValue}" Binding="{Binding Value}" Width="65*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </TabItem>

        <TabItem Header="{Binding TagsTabLabel}" IsVisible="{Binding IsFile}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="status"
                       Classes.warning="{Binding TagsNotice.IsWarning}"
                       Text="{Binding TagsNotice.Text}" TextWrapping="Wrap" Margin="{StaticResource GapAroundMd}"/>
            <TableView ItemsSource="{Binding Tags}"
                       AutomationProperties.Name="{Binding TagsAccessibleName}">
              <TableView.Columns>
                <TableViewColumn Header="{Binding ColumnName}" Binding="{Binding Name}" Width="40*"/>
                <TableViewColumn Header="{Binding ColumnValue}" Binding="{Binding Value}" Width="60*"/>
              </TableView.Columns>
            </TableView>
          </DockPanel>
        </TabItem>
        <TabItem Header="{Binding ChecksumTabLabel}" IsVisible="{Binding IsFile}">
          <StackPanel Spacing="{StaticResource SpaceSm}" Margin="{StaticResource GapAboveMd}">
            <TextBlock Classes="status"
                       Classes.success="{Binding ChecksumNotice.IsSuccess}"
                       Classes.warning="{Binding ChecksumNotice.IsWarning}"
                       Text="{Binding ChecksumNotice.Text}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" IsVisible="{Binding HasChecksum}">
              <TextBlock Classes="muted" Text="{Binding ChecksumAlgorithmLabel}" VerticalAlignment="Center"/>
              <SelectableTextBlock FontFamily="{DynamicResource AppFontMono}" Text="{Binding Checksum}"
                                   AutomationProperties.Name="{Binding ChecksumAccessibleName}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <Button Content="{Binding GetChecksumLabel}" Command="{Binding GetChecksumCommand}"/>
              <Button Content="{Binding ComputeChecksumLabel}" Command="{Binding ComputeChecksumCommand}"
                      ToolTip.Tip="{Binding ComputeChecksumHint}"/>
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</Window>
