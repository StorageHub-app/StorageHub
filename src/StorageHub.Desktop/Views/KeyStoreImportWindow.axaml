<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.KeyStoreImportWindow"
        x:DataType="vm:KeyStoreImportModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!--
    One dialog for the whole import. The Import button is dim with the reason underneath until
    the draft is one the agent will take, so nobody enrols a 20 MB file to be told afterwards.
  -->

  <Border Classes="surface" Padding="{StaticResource PaddingLg}">
    <StackPanel Spacing="{StaticResource SpaceMd}">
      <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap"/>

      <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Classes="caption" Text="{Binding FileLabel}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
          <TextBox Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay}"
                   AutomationProperties.Name="{Binding FileLabel}"/>
          <Button Grid.Column="1" Content="{Binding BrowseLabel}" Command="{Binding BrowseCommand}"/>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Classes="caption" Text="{Binding NameLabel}"/>
        <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding NameLabel}"/>
      </StackPanel>

      <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Classes="caption" Text="{Binding PassphraseLabel}"/>
        <TextBox x:Name="PART_Passphrase" Text="{Binding Passphrase, Mode=TwoWay}"
                 PasswordChar="●"
                 AutomationProperties.Name="{Binding PassphraseLabel}"/>
        <TextBlock Classes="muted" Text="{Binding PassphraseHint}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Spacing="{StaticResource SpaceXs}" IsVisible="{Binding ShowsFormat}">
        <TextBlock Classes="caption" Text="{Binding FormatLabel}"/>
        <ComboBox ItemsSource="{Binding Formats}"
                  SelectedItem="{Binding Format, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{Binding FormatLabel}"/>
      </StackPanel>

      <TextBlock Classes="caption danger" IsVisible="{Binding HasProblem}"
                 Text="{Binding Problem}" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="{StaticResource SpaceSm}" Margin="0,8,0,0">
        <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"/>
        <Button Classes="primary" Content="{Binding ImportLabel}"
                IsDefault="True" Command="{Binding ImportCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
