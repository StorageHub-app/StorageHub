<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Every colour, metric, radius and type size the shell uses. One file, on purpose.

    The WinForms shell spread these across UiTheme, StorageHubFieldChrome, DisplayMetrics and a few
    hundred literals in layout code, and converted each one by hand with LogicalToDeviceUnits - 761
    call sites, of which 48 were missed and became the DPI defects this port exists to end. Here
    there is nothing to convert: Avalonia lays out in device-independent pixels, so a number written
    once is correct at 100%, 125%, 150% and 200%, on Windows and on Linux alike. A literal pixel in
    a view is therefore not a scaling bug any more - it is just a number that should have been a
    token, and this file is where it belongs.

    Colours are ThemeDictionaries and resolved with DynamicResource, because they change when the
    appearance does and the tree has to repaint. Metrics are plain resources and resolved with
    StaticResource, because they never change and a dynamic lookup would cost a subscription per
    use for nothing.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- Transcribed from UiTheme.cs DarkPalette. The twenty semantic slots, unchanged. -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="CanvasColor">#FF16181D</Color>
      <Color x:Key="SurfaceColor">#FF1E2127</Color>
      <Color x:Key="SurfaceMutedColor">#FF272B33</Color>
      <Color x:Key="ElevatedColor">#FF2E323B</Color>
      <Color x:Key="BorderColor">#FF3A3F4A</Color>
      <Color x:Key="TextColor">#FFE8EAF0</Color>
      <Color x:Key="TextMutedColor">#FFA0A7B4</Color>
      <Color x:Key="PrimaryColor">#FF4C8BF5</Color>
      <Color x:Key="PrimaryHoverColor">#FF6BA0F8</Color>
      <Color x:Key="PrimaryPressedColor">#FF3872D6</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>

      <!-- FluentTheme derives its own chrome from this ramp: the selected-tab pipe, focus adorners,
           checkbox and radio fills, slider tracks and scrollbar thumbs. Left alone it paints them in
           the stock Windows accent, which is how a themed app still ends up with one control in the
           wrong blue. Light1/Dark1 are the hover and pressed primaries above; the outer steps
           continue the same ramp. -->
      <Color x:Key="SystemAccentColor">#FF4C8BF5</Color>
      <Color x:Key="SystemAccentColorLight1">#FF6BA0F8</Color>
      <Color x:Key="SystemAccentColorLight2">#FF8AB5FA</Color>
      <Color x:Key="SystemAccentColorLight3">#FFA9CAFC</Color>
      <Color x:Key="SystemAccentColorDark1">#FF3872D6</Color>
      <Color x:Key="SystemAccentColorDark2">#FF2C5CAD</Color>
      <Color x:Key="SystemAccentColorDark3">#FF204584</Color>
      <Color x:Key="SelectionColor">#FF2B4A7A</Color>
      <Color x:Key="SelectionPressedColor">#FF23395C</Color>
      <Color x:Key="InputColor">#FF14161A</Color>
      <Color x:Key="DisabledTextColor">#FF6B7280</Color>
      <Color x:Key="SuccessColor">#FF4ABE84</Color>
      <Color x:Key="WarningColor">#FFF0B045</Color>
      <Color x:Key="DangerColor">#FFF4696F</Color>
      <Color x:Key="SuccessTintColor">#FF1B2F27</Color>
      <Color x:Key="WarningTintColor">#FF33291A</Color>
      <Color x:Key="DangerTintColor">#FF33201F</Color>
    </ResourceDictionary>

    <!-- Transcribed from UiTheme.cs LightPalette. -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="CanvasColor">#FFF4F6FA</Color>
      <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
      <Color x:Key="SurfaceMutedColor">#FFEDF1F7</Color>
      <Color x:Key="ElevatedColor">#FFF9FBFD</Color>
      <Color x:Key="BorderColor">#FFD3DAE4</Color>
      <Color x:Key="TextColor">#FF1E242D</Color>
      <Color x:Key="TextMutedColor">#FF5C6674</Color>
      <Color x:Key="PrimaryColor">#FF1867C0</Color>
      <Color x:Key="PrimaryHoverColor">#FF297BD6</Color>
      <Color x:Key="PrimaryPressedColor">#FF12529A</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>

      <!-- FluentTheme derives its own chrome from this ramp: the selected-tab pipe, focus adorners,
           checkbox and radio fills, slider tracks and scrollbar thumbs. Left alone it paints them in
           the stock Windows accent, which is how a themed app still ends up with one control in the
           wrong blue. Light1/Dark1 are the hover and pressed primaries above; the outer steps
           continue the same ramp. -->
      <Color x:Key="SystemAccentColor">#FF1867C0</Color>
      <Color x:Key="SystemAccentColorLight1">#FF297BD6</Color>
      <Color x:Key="SystemAccentColorLight2">#FF4A93E0</Color>
      <Color x:Key="SystemAccentColorLight3">#FF6FAAE9</Color>
      <Color x:Key="SystemAccentColorDark1">#FF12529A</Color>
      <Color x:Key="SystemAccentColorDark2">#FF0E3E75</Color>
      <Color x:Key="SystemAccentColorDark3">#FF092A4F</Color>
      <Color x:Key="SelectionColor">#FFDAE8FA</Color>
      <Color x:Key="SelectionPressedColor">#FFC3DAF7</Color>
      <Color x:Key="InputColor">#FFFDFEFF</Color>
      <Color x:Key="DisabledTextColor">#FF929AA5</Color>
      <Color x:Key="SuccessColor">#FF118756</Color>
      <Color x:Key="WarningColor">#FFB05E00</Color>
      <Color x:Key="DangerColor">#FFBE2D37</Color>
      <Color x:Key="SuccessTintColor">#FFE6F6EE</Color>
      <Color x:Key="WarningTintColor">#FFFFF4E0</Color>
      <Color x:Key="DangerTintColor">#FFFDECEC</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    One brush per colour, so a view names a brush and never constructs one. Every brush points at
    the colour of the same name, which is what makes flipping RequestedThemeVariant repaint the live
    tree - and what deletes the 250-line recursive theme walker the WinForms shell needed.
  -->
  <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{DynamicResource OnPrimaryColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{DynamicResource SurfaceMutedColor}"/>
  <SolidColorBrush x:Key="ElevatedBrush" Color="{DynamicResource ElevatedColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{DynamicResource PrimaryPressedColor}"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}"/>
  <SolidColorBrush x:Key="SelectionPressedBrush" Color="{DynamicResource SelectionPressedColor}"/>
  <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{DynamicResource DisabledTextColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessTintBrush" Color="{DynamicResource SuccessTintColor}"/>
  <SolidColorBrush x:Key="WarningTintBrush" Color="{DynamicResource WarningTintColor}"/>
  <SolidColorBrush x:Key="DangerTintBrush" Color="{DynamicResource DangerTintColor}"/>

  <!--
    Fluent keys that TableView's template reads directly. The column-heading band is painted with
    this brush, which Fluent resolves to its own #1F1F1F in every scheme; pointing it at the surface
    puts the band back in the palette.
  -->
  <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="{DynamicResource SurfaceColor}"/>
  <!--
    A drop-down that is unavailable, as 1.4's choice field drew one: a quiet field with its edge,
    and its words and chevron dimmed. Fluent fills it with its own solid grey and no edge, and the
    queue's Reconcile drop-down is unavailable most of the time, so it was the heaviest thing on
    the bar.
  -->
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource SurfaceMutedColor}"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{DynamicResource BorderColor}"/>
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource DisabledTextColor}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{DynamicResource DisabledTextColor}"/>

  <!--
    Spacing, on a four-unit scale. A view picks a step rather than a number, which is what keeps
    two panels that should look alike from drifting a pixel apart.
  -->
  <sys:Double x:Key="SpaceXs">2</sys:Double>
  <sys:Double x:Key="SpaceSm">4</sys:Double>
  <sys:Double x:Key="SpaceMd">8</sys:Double>
  <sys:Double x:Key="SpaceLg">12</sys:Double>
  <sys:Double x:Key="SpaceXl">16</sys:Double>
  <sys:Double x:Key="Space2Xl">24</sys:Double>

  <Thickness x:Key="PaddingSm">4</Thickness>
  <Thickness x:Key="PaddingMd">8</Thickness>
  <Thickness x:Key="PaddingLg">12</Thickness>
  <Thickness x:Key="PagePadding">16</Thickness>

  <!--
    Gaps between stacked blocks, on the same steps: a margin on one side only, so a block is moved
    clear of its neighbour without moving away from its container's edges. Above, below, on both
    vertical sides ("Around"), or after it in a row.
  -->
  <Thickness x:Key="GapAboveXs">0,2,0,0</Thickness>
  <Thickness x:Key="GapAboveSm">0,4,0,0</Thickness>
  <Thickness x:Key="GapAboveMd">0,8,0,0</Thickness>
  <Thickness x:Key="GapAboveLg">0,12,0,0</Thickness>
  <Thickness x:Key="GapBelowXs">0,0,0,2</Thickness>
  <Thickness x:Key="GapBelowSm">0,0,0,4</Thickness>
  <Thickness x:Key="GapBelowMd">0,0,0,8</Thickness>
  <Thickness x:Key="GapBelowLg">0,0,0,12</Thickness>
  <Thickness x:Key="GapAroundSm">0,4</Thickness>
  <Thickness x:Key="GapAroundMd">0,8</Thickness>
  <Thickness x:Key="GapAroundLg">0,12</Thickness>
  <Thickness x:Key="GapAfterSm">0,0,4,0</Thickness>
  <Thickness x:Key="GapAfterMd">0,0,8,0</Thickness>
  <!-- Off the scale, as those screens were laid out: a dialog's heading or footer block and the
       body between them, a little more than SpaceMd apart. -->
  <Thickness x:Key="BlockGapAbove">0,10,0,0</Thickness>
  <Thickness x:Key="BlockGapBelow">0,0,0,10</Thickness>
  <!-- Below one entry of a checklist, a search box over its list, and the splash's logo: between
       SpaceSm and SpaceMd. -->
  <Thickness x:Key="ItemGapBelow">0,0,0,6</Thickness>
  <!-- A heading over a short list inside a dialog: clear of what is above, close to its list. -->
  <Thickness x:Key="ListHeadingMargin">0,8,0,4</Thickness>
  <!-- A row of controls or a status line inset from its panel's edges: the pane's address row and
       footer, the activity log's status. SpaceMd across, SpaceSm above and below. -->
  <Thickness x:Key="RowInsetMargin">8,4</Thickness>
  <!-- A glyph inside a text box, clear of its left edge: the search glyph in a pane's filter. -->
  <Thickness x:Key="InnerGlyphMargin">6,0,0,0</Thickness>
  <!-- Fields that only apply while the checkbox above them is ticked, indented under it. -->
  <Thickness x:Key="DependentFieldIndent">20,0,0,0</Thickness>
  <!-- A progress bar that only says something is happening: a thin line. -->
  <sys:Double x:Key="IndeterminateBarHeight">4</sys:Double>
  <!-- Between an icon and the name beside it in a list or tree row. -->
  <sys:Double x:Key="IconLabelSpacing">6</sys:Double>

  <!--
    Field metrics, from StorageHubFieldChrome. The dense variant is what the toolbar used, and it
    exists so a field hosted in a toolbar sits on the same baseline as one in a dialog.
  -->
  <Thickness x:Key="FieldPadding">10,8</Thickness>
  <Thickness x:Key="DenseFieldPadding">8,3</Thickness>
  <!-- A checked toolbar button's frame, and DenseFieldPadding less that frame, so the button is
       the size it is unchecked. Change the three together. Square, as 1.4 drew it. -->
  <Thickness x:Key="CheckedToolBorder">1</Thickness>
  <Thickness x:Key="CheckedToolPadding">7,2</Thickness>
  <CornerRadius x:Key="CheckedToolRadius">0</CornerRadius>
  <!-- A ticked menu entry's frame around its icon: the same frame, with room around the icon.
       The outset is the padding and the frame, negated, so the frame draws outside the icon's
       slot and the entry keeps its size. Change the two together. -->
  <Thickness x:Key="MenuCheckPadding">2</Thickness>
  <Thickness x:Key="MenuCheckOutset">-3</Thickness>
  <!-- A selected connection card's edit and delete, on its second line as 1.4 drew them: a little
       room around each icon, and that room negated above and below, so the line is no taller with
       them on it than without. Change the two together. -->
  <Thickness x:Key="CardActionPadding">2</Thickness>
  <Thickness x:Key="CardActionOutset">0,-2</Thickness>
  <CornerRadius x:Key="FieldRadius">5</CornerRadius>
  <CornerRadius x:Key="DenseFieldRadius">4</CornerRadius>
  <CornerRadius x:Key="CardRadius">7</CornerRadius>
  <CornerRadius x:Key="ButtonRadius">5</CornerRadius>
  <sys:Double x:Key="TrailingZoneWidth">24</sys:Double>
  <sys:Double x:Key="DenseTrailingZoneWidth">18</sys:Double>

  <!--
    Chrome heights. Written once here rather than per view, so the toolbar and the tab strip cannot
    disagree about how tall a row is.
  -->
  <!-- The menu bar sizes its own row. Padding on a menu-bar item has to be horizontal only: the
       bar gives each item a fixed height, so vertical padding makes the content taller than its
       slot and the labels clip at both ends rather than the row growing. -->
  <!-- The bar under a selected tab. Selection's alone: hover does not draw it. -->
  <sys:Double x:Key="TabAccentThickness">2</sys:Double>
  <!-- The provider's colour along the top of the Edit Connection dialog, as thick as 1.4's. -->
  <sys:Double x:Key="ProviderAccentThickness">4</sys:Double>
  <!-- A boxed tab, from 1.4's strip: about 120 wide at minimum, one list row tall, 2 apart. -->
  <sys:Double x:Key="TabMinWidth">120</sys:Double>
  <sys:Double x:Key="TabHeight">26</sys:Double>
  <Thickness x:Key="TabPadding">10,3</Thickness>
  <Thickness x:Key="TabMargin">0,2,2,0</Thickness>
  <CornerRadius x:Key="TabRadius">4,4,0,0</CornerRadius>
  <sys:Double x:Key="MenuBarHeight">30</sys:Double>
  <Thickness x:Key="MenuItemPadding">10,0</Thickness>
  <sys:Double x:Key="ToolbarHeight">36</sys:Double>
  <!-- A drop-down in a toolbar, 1.4's 170: one width whichever entry is chosen, so choosing a
       long one does not push the buttons after it along. What does not fit is trimmed. -->
  <sys:Double x:Key="ToolbarChoiceWidth">170</sys:Double>
  <!-- The toolbar's chevron, which the row leaves room for once a button does not fit: as wide as
       a tool button with only an icon, DenseFieldPadding either side of IconSizeMd. Change the
       three together. -->
  <sys:Double x:Key="ToolbarOverflowWidth">34</sys:Double>
  <!-- 1.4's StatusStrip, top line included: one line of text with a little room above and below. -->
  <sys:Double x:Key="StatusBarHeight">22</sys:Double>
  <!-- The status bar's cells, a little apart on either side of the thin line between them, which
       stops short of the bar's top and bottom as 1.4's did. The bar's padding is horizontal only:
       vertical padding, or a cell's, made it nearly twice 1.4's height. -->
  <Thickness x:Key="StatusBarPadding">4,0</Thickness>
  <Thickness x:Key="StatusCellMargin">5,0</Thickness>
  <Thickness x:Key="StatusSeparatorMargin">0,4</Thickness>
  <sys:Double x:Key="ListRowHeight">24</sys:Double>
  <!-- Fluent's own key: the padding of every TableView row and of its heading band. Fluent's
       6,9,6,12 made a row 37 tall; 1.4's lists were about 20, as dense as Explorer's. -->
  <Thickness x:Key="TableViewRowPadding">6,3</Thickness>
  <!-- The column dividers in a heading band are its resize grips, stretched to the band's height
       by a negative margin that has to match the padding above. Fluent's is for its own 9/12, so
       once the band was made 3/3 the dividers stuck out above it and down into the first row of
       every table in the app. Keep the two in step. -->
  <Thickness x:Key="TableViewColumnResizerMargin">0,-3,-6,-3</Thickness>
  <sys:Double x:Key="TreeRowHeight">22</sys:Double>
  <!-- The connections panel's narrowest. Its width is saved in device pixels, within 1.4's own
       220 to 640 (DesktopUpdatePreferences), which at high scaling is narrower than the panel's
       header: its title, New and its menu fit from about this width, which is the floor. -->
  <sys:Double x:Key="SidebarMinWidth">220</sys:Double>
  <!-- A group's heading in the connections panel: one height whether or not it has a menu, so
       Favorites, a group and Ungrouped sit evenly apart. The height of a tool button. -->
  <sys:Double x:Key="GroupHeaderHeight">24</sys:Double>
  <!-- The square a group's glyph sits in: a muted icon, the star, or a small tile in the group's
       colour with a white icon, as a card's tile is, so the names line up whichever it has. -->
  <sys:Double x:Key="GroupGlyphSize">18</sys:Double>
  <sys:Double x:Key="GroupTileIconSize">12</sys:Double>
  <!-- Between the glyph and the name, on top of the heading's column spacing (SpaceSm): SpaceMd
       in all. Then the count, a little after the name. -->
  <Thickness x:Key="GroupTitleMargin">4,0,0,0</Thickness>
  <Thickness x:Key="GroupCountMargin">6,0,0,0</Thickness>
  <!-- "No connections" under an open empty group, starting under its name: the disclosure (18),
       the glyph (GroupGlyphSize), the two column gaps and GroupTitleMargin. Change them together. -->
  <Thickness x:Key="GroupEmptyMargin">48,0,0,0</Thickness>
  <!-- The connection details' row of actions, a step below the facts above it. -->
  <Thickness x:Key="DetailActionsMargin">0,8,0,0</Thickness>
  <sys:Double x:Key="SplitterThickness">4</sys:Double>
  <!-- Layout limits (docs/ui-rules.md, Layout). A pane is never smaller than its chrome, which
       BrowserPaneView measures, plus its list's heading and this many rows; the address field
       keeps this much of its own width beside its buttons and the filter. -->
  <sys:Double x:Key="PaneMinimumListRows">2</sys:Double>
  <sys:Double x:Key="PaneAddressMinWidth">120</sys:Double>
  <!-- The transfer queue's height when the shell opens, and the rows it keeps under its toolbar,
       tabs and heading however far its splitter is dragged. -->
  <sys:Double x:Key="TransferQueueHeight">240</sys:Double>
  <sys:Double x:Key="QueueMinimumRows">2</sys:Double>

  <!--
    The Settings window, from 1.4's SettingsForm and SettingsRow (ui-reference 02). The page is
    capped at a content width rather than filled: a row puts its control against its trailing
    edge, and across a wide window that edge ends up so far from its setting that the two read as
    unrelated columns.
  -->
  <sys:Double x:Key="SettingsNavigationWidth">288</sys:Double>
  <sys:Double x:Key="SettingsContentWidth">720</sys:Double>
  <Thickness x:Key="SettingsNavigationPadding">12,18,10,12</Thickness>
  <Thickness x:Key="SettingsPagePadding">32,24,32,20</Thickness>
  <!-- Inside a card: the row's own room, and the hairline between rows indented to its text. -->
  <Thickness x:Key="SettingsRowPadding">16,11</Thickness>
  <Thickness x:Key="SettingsDividerMargin">16,0</Thickness>
  <!-- Between a page's heading and a screen that has no caption of its own to keep them apart. -->
  <Thickness x:Key="SettingsHeadingMargin">0,0,0,18</Thickness>
  <!-- The capitalised caption over a card: clear of the card above, close to its own. -->
  <Thickness x:Key="SettingsCaptionMargin">0,18,0,6</Thickness>
  <sys:Double x:Key="SettingsCaptionLetterSpacing">1</sys:Double>
  <!-- What follows the cards: a card with no caption, a page's button, its footnote. -->
  <Thickness x:Key="SettingsAfterCardMargin">0,14,0,0</Thickness>
  <sys:Double x:Key="SettingsChoiceWidth">280</sys:Double>
  <sys:Double x:Key="SettingsNumberWidth">150</sys:Double>
  <!-- Each of a number field's two stacked arrows: half the field's height, and narrow. -->
  <sys:Double x:Key="SettingsSpinnerButtonWidth">22</sys:Double>
  <sys:Double x:Key="SettingsSpinnerButtonHeight">15</sys:Double>
  <sys:Double x:Key="SettingsSpinnerGlyphSize">9</sys:Double>
  <!-- No room after the value, so the unit follows it as one phrase: "4 jobs", not "4   jobs". -->
  <Thickness x:Key="SettingsNumberPadding">10,8,0,8</Thickness>
  <sys:Double x:Key="SettingsKeyWidth">200</sys:Double>
  <sys:Double x:Key="SettingsShortcutCaptureWidth">180</sys:Double>
  <!-- A number's unit, inside its field between the value and the spinner: "4 jobs". -->
  <Thickness x:Key="SettingsUnitMargin">4,0,8,0</Thickness>
  <!-- The source badge inside a secret reference box, clear of the box's left edge, as the
       search glyph sits in a pane's filter box. -->
  <Thickness x:Key="SecretSourceBadgeMargin">6,0,0,0</Thickness>
  <!--
    The message box, drawn as Windows draws one: sized to its text between a minimum and a maximum
    width, a 32 px icon beside the message, and a footer band whose buttons are the dense standard
    size (about 26 px tall at 100%, at least 80 wide), 8 px apart.
  -->
  <sys:Double x:Key="DialogButtonMinWidth">80</sys:Double>
  <Thickness x:Key="DialogButtonPadding">12,4</Thickness>
  <sys:Double x:Key="DialogMinWidth">360</sys:Double>
  <sys:Double x:Key="DialogMaxWidth">520</sys:Double>
  <sys:Double x:Key="DialogIconSize">32</sys:Double>
  <!-- A dialog that asks for a name: wide enough for a long file name without resizing. -->
  <sys:Double x:Key="DialogPromptWidth">420</sys:Double>
  <Thickness x:Key="DialogContentPadding">16,18,20,18</Thickness>
  <Thickness x:Key="DialogFooterPadding">12,8</Thickness>
  <!-- Keeps a footer checkbox's label clear of the first button when the label is long. -->
  <Thickness x:Key="DialogFooterCheckBoxMargin">0,0,16,0</Thickness>
  <!-- The detail under a message, a short step below it as the second paragraph of a message box. -->
  <Thickness x:Key="DialogDetailMargin">0,8,0,0</Thickness>
  <Thickness x:Key="SettingsNavigationTitleMargin">6,0,0,8</Thickness>
  <!-- The navigation rail. Every row keeps one column for icons, one for captions and one for
       names, whatever its depth, so the eye has a single line to follow down each. -->
  <sys:Double x:Key="SettingsNavigationRowHeight">28</sys:Double>
  <Thickness x:Key="SettingsNavigationItemMargin">0,1,4,1</Thickness>
  <Thickness x:Key="SettingsNavigationChevronMargin">2,0,0,0</Thickness>
  <Thickness x:Key="SettingsNavigationIconMargin">24,0,0,0</Thickness>
  <Thickness x:Key="SettingsNavigationTextMargin">54,0,6,0</Thickness>
  <Thickness x:Key="SettingsNavigationCaptionMargin">42,10,6,2</Thickness>
  <Thickness x:Key="SettingsNavigationGuideMargin">42,0,0,0</Thickness>
  <!-- The selected row's accent, down its leading edge as 1.4 drew it. -->
  <sys:Double x:Key="SettingsNavigationAccentWidth">3</sys:Double>
  <Thickness x:Key="SettingsNavigationAccentMargin">0,5</Thickness>

  <!-- The connection details: the key column, wide enough for "Operation timeout" as 1.4's
       104 px was, and the space above each section's heading. -->
  <GridLength x:Key="DetailKeyWidth">104</GridLength>
  <Thickness x:Key="DetailSectionMargin">0,6,0,1</Thickness>

  <!-- The line that explains a radio choice, indented under its label as 1.4 laid it out. -->
  <Thickness x:Key="ChoiceDetailMargin">24,0,0,0</Thickness>
  <!-- A button inside a card, a step clear of the text it acts on. -->
  <Thickness x:Key="CardActionMargin">0,4,0,0</Thickness>
  <!-- The installation check: its summary line across the top, and the cards below it, inset from
       the window's edges and clear of the footer band. -->
  <Thickness x:Key="InstallationSummaryMargin">16,10,16,4</Thickness>
  <Thickness x:Key="InstallationFindingsMargin">12,4,12,12</Thickness>

  <!--
    The browser pane (BrowserPaneView). Its minimum size is measured from what it is drawn with,
    so these can change without the layout limits being told.
  -->
  <!-- The connection's colour across the pane under its title bar, as 1.x drew it. -->
  <sys:Double x:Key="PaneAccentThickness">3</sys:Double>
  <!-- Every pane's border, focused or not: 1.x's was three, which took more room than it earned. -->
  <Thickness x:Key="PaneBorderThickness">2</Thickness>
  <!-- The chips in the connection bar; the name in the first is trimmed past its maximum. -->
  <Thickness x:Key="PaneChipPadding">10,4</Thickness>
  <sys:Double x:Key="PaneChipMinHeight">34</sys:Double>
  <sys:Double x:Key="PaneChipNameMaxWidth">260</sys:Double>
  <!-- The connection picker beside the state: 280 when there is room, down to 140 when not. -->
  <sys:Double x:Key="PanePickerMinWidth">140</sys:Double>
  <sys:Double x:Key="PanePickerMaxWidth">280</sys:Double>
  <sys:Double x:Key="PaneFilterWidth">170</sys:Double>
  <!-- The folder tree's width when a pane opens, and when it is shown again before being dragged. -->
  <GridLength x:Key="PaneTreeWidth">185</GridLength>
  <Thickness x:Key="PaneTreePadding">0,4</Thickness>
  <!-- The tree's loading spinner, drawn in the room the expander leaves left of the icon. -->
  <Thickness x:Key="TreeSpinnerOutset">-22,0,0,0</Thickness>
  <!-- The narrowest the Name column gets before the fixed columns give way (TableColumnRules). -->
  <sys:Double x:Key="PaneNameColumnMinWidth">160</sys:Double>
  <!-- Size, right-aligned, kept clear of the divider after it. -->
  <Thickness x:Key="SizeCellMargin">0,0,6,0</Thickness>
  <!-- "Fetching folder" and its bar over the list while a folder is read. -->
  <sys:Double x:Key="PaneLoadingWidth">200</sys:Double>
  <Thickness x:Key="PaneBannerPadding">10,6</Thickness>
  <!-- The pane's FILES bar and its small captions. -->
  <Thickness x:Key="PaneCommandsPadding">8,2</Thickness>
  <Thickness x:Key="PaneCaptionMargin">2,0,4,0</Thickness>
  <!-- A dense field's height (ComboBox.dense, TextBox.dense), and a dense drop-down's padding. -->
  <sys:Double x:Key="DenseFieldMinHeight">26</sys:Double>
  <Thickness x:Key="DenseChoicePadding">8,2</Thickness>
  <!-- A workspace tab's close button: a small X, a step clear of the title. -->
  <sys:Double x:Key="TabCloseIconSize">12</sys:Double>
  <Thickness x:Key="TabClosePadding">3</Thickness>
  <Thickness x:Key="TabCloseMargin">12,0,0,0</Thickness>
  <!-- A transfer's progress bar inside its cell: rounded a little, and inset from the row's edges. -->
  <CornerRadius x:Key="TransferBarRadius">3</CornerRadius>
  <Thickness x:Key="ProgressCellMargin">0,3</Thickness>
  <!-- The queue's message at the end of its toolbar, clear of the buttons and the window's edge. -->
  <Thickness x:Key="QueueMessageMargin">12,0,8,0</Thickness>

  <!--
    The connections panel, its cards, and the connection picker.
  -->
  <!-- The search box across the top, with room inside for its glyph and its clear button. -->
  <Thickness x:Key="SidebarSearchMargin">12,0</Thickness>
  <Thickness x:Key="SidebarSearchPadding">30,8,32,8</Thickness>
  <Thickness x:Key="SidebarListMargin">12,12,12,0</Thickness>
  <!-- The list's scroll bar, a little slimmer than the theme's, and kept off the cards' edge. -->
  <sys:Double x:Key="SidebarScrollBarSize">12</sys:Double>
  <Thickness x:Key="SidebarScrollBarGap">4,0,0,0</Thickness>
  <!-- The selected connection's details under the list. -->
  <sys:Double x:Key="ConnectionDetailsHeight">230</sys:Double>
  <Thickness x:Key="ConnectionRowPadding">10,8</Thickness>
  <!-- The rounded square holding a connection's icon. -->
  <sys:Double x:Key="IconTileSize">34</sys:Double>
  <CornerRadius x:Key="IconTileRadius">8</CornerRadius>
  <!-- A group's disclosure arrow. -->
  <Thickness x:Key="DisclosurePadding">2</Thickness>
  <sys:Double x:Key="DisclosureSize">18</sys:Double>
  <!-- Small labels: a card's tags, the details' provider badge, a pane's type and provider pills,
       and the bordered badge. -->
  <CornerRadius x:Key="TagRadius">4</CornerRadius>
  <Thickness x:Key="TagPadding">6,1</Thickness>
  <Thickness x:Key="DetailBadgePadding">6,2</Thickness>
  <CornerRadius x:Key="PillRadius">10</CornerRadius>
  <Thickness x:Key="PillPadding">8,1</Thickness>
  <Thickness x:Key="BadgePadding">4,1</Thickness>
  <!-- One fact in the connection details, a pixel clear of the next. -->
  <Thickness x:Key="DetailRowMargin">0,1</Thickness>
  <!-- The connection picker's group headings and its cards. -->
  <Thickness x:Key="PickerHeadingMargin">6,10,6,2</Thickness>
  <Thickness x:Key="PickerCardMargin">2</Thickness>

  <!--
    The connection editor (ConnectionManagerWindow).
  -->
  <Thickness x:Key="EditorHeaderPadding">16,12</Thickness>
  <Thickness x:Key="EditorFooterPadding">16,10</Thickness>
  <Thickness x:Key="EditorTabsMargin">8,6,0,0</Thickness>
  <Thickness x:Key="EditorSectionMargin">16,16,24,8</Thickness>
  <!-- A section's hint under its title: close to the title, clear of the first field. -->
  <Thickness x:Key="SectionHintMargin">0,2,0,10</Thickness>
  <!-- A field's label column, and the label wrapping inside it. -->
  <GridLength x:Key="EditorLabelColumnWidth">190</GridLength>
  <sys:Double x:Key="EditorLabelMaxWidth">180</sys:Double>
  <!-- The Type and Provider drop-downs in the header. -->
  <sys:Double x:Key="EditorTypeChoiceWidth">260</sys:Double>
  <!-- The accent colour swatches: round, wrapping within a short row, a ring on hover and choice. -->
  <sys:Double x:Key="SwatchSize">18</sys:Double>
  <CornerRadius x:Key="SwatchRadius">9</CornerRadius>
  <Thickness x:Key="SwatchRingThickness">2</Thickness>
  <sys:Double x:Key="SwatchSpacing">6</sys:Double>
  <sys:Double x:Key="SwatchPanelMaxWidth">200</sys:Double>
  <Thickness x:Key="BadgePreviewPadding">10,6</Thickness>
  <Thickness x:Key="TrustNoticePadding">14,10</Thickness>
  <Thickness x:Key="TrustNoticeMargin">16,16,24,0</Thickness>
  <!-- A connection test's steps: the step, its outcome, then the detail. -->
  <GridLength x:Key="TestStepLabelColumnWidth">180</GridLength>
  <GridLength x:Key="TestStepOutcomeColumnWidth">110</GridLength>

  <!--
    Other windows' own parts.
  -->
  <!-- The app's logo on About and the splash, and the splash's frame. -->
  <sys:Double x:Key="AboutLogoSize">56</sys:Double>
  <sys:Double x:Key="AboutButtonMinWidth">88</sys:Double>
  <sys:Double x:Key="SplashLogoSize">64</sys:Double>
  <Thickness x:Key="SplashPadding">28,28,28,24</Thickness>
  <!-- One choice in the icon picker, and its glyph. -->
  <sys:Double x:Key="IconChoiceSize">40</sys:Double>
  <sys:Double x:Key="IconChoiceGlyphSize">22</sys:Double>
  <!-- A layout preset's picture in New Workspace. -->
  <sys:Double x:Key="PresetThumbnailHeight">96</sys:Double>
  <!-- An overview metric card: a coloured rail down its left edge, a hairline elsewhere. -->
  <Thickness x:Key="MetricBorderThickness">2,1,1,1</Thickness>
  <!-- The tables on Welcome and Sync tasks, a few rows tall each. -->
  <sys:Double x:Key="OverviewTableHeight">140</sys:Double>
  <sys:Double x:Key="SyncTasksTableHeight">170</sys:Double>
  <sys:Double x:Key="LastSyncsTableHeight">120</sys:Double>
  <!-- The sync location picker: its heading band, the address row and the folder list. -->
  <Thickness x:Key="PickerHeaderPadding">18,12,18,10</Thickness>
  <Thickness x:Key="PickerAddressMargin">12,10,12,8</Thickness>
  <Thickness x:Key="PickerListMargin">12,0,12,8</Thickness>
  <sys:Double x:Key="PickerPathMaxWidth">280</sys:Double>
  <!-- A settings file's password: a short label column and a field long enough for a passphrase.
       PasswordFieldWidth and PasswordFieldColumnWidth are the same field on two screens. -->
  <GridLength x:Key="PasswordLabelColumnWidth">90</GridLength>
  <GridLength x:Key="PasswordFieldColumnWidth">280</GridLength>
  <sys:Double x:Key="PasswordFieldWidth">280</sys:Double>
  <!-- Settings import's conflict policy drop-down. -->
  <sys:Double x:Key="ImportChoiceWidth">320</sys:Double>
  <!-- The buttons between the toolbar settings' two lists. -->
  <sys:Double x:Key="ToolbarSettingsButtonsWidth">150</sys:Double>
  <!-- A filter or search box at the end of a tool window's top row. -->
  <GridLength x:Key="CompareFilterColumnWidth">220</GridLength>
  <GridLength x:Key="KeyStoreSearchColumnWidth">240</GridLength>
  <!-- Permissions' octal field: four digits. -->
  <GridLength x:Key="OctalFieldColumnWidth">96</GridLength>
  <!-- The schedule editor beside the list, and its fields. -->
  <GridLength x:Key="ScheduleEditorWidth">440</GridLength>
  <sys:Double x:Key="ScheduleDayChoiceMinWidth">180</sys:Double>
  <sys:Double x:Key="ScheduleDayNumberMinWidth">140</sys:Double>
  <sys:Double x:Key="ScheduleGraceMinWidth">160</sys:Double>
  <sys:Double x:Key="TimeZoneDropDownMaxHeight">320</sys:Double>
  <!-- The sync profile editor's fields. -->
  <sys:Double x:Key="ProfileChoiceMinWidth">260</sys:Double>
  <sys:Double x:Key="ProfileNameWidth">520</sys:Double>
  <sys:Double x:Key="BehaviorListMaxHeight">260</sys:Double>
  <sys:Double x:Key="ConflictChoiceMinWidth">280</sys:Double>
  <!-- A multi-line glob list: about five lines. -->
  <sys:Double x:Key="GlobListHeight">96</sys:Double>
  <!-- Sync run history's run id box. -->
  <sys:Double x:Key="RunIdMinWidth">320</sys:Double>
  <sys:Double x:Key="RunIdMaxWidth">360</sys:Double>

  <!--
    Fixed table column widths (docs/ui-rules.md, Tables: a column is * or a number). One token per
    kind of column where several tables show the same kind, so a date reads the same width
    everywhere; the rest are the one table's own.
  -->
  <GridLength x:Key="SizeColumnWidth">90</GridLength>
  <GridLength x:Key="DateColumnWidth">140</GridLength>
  <GridLength x:Key="KindColumnWidth">140</GridLength>
  <GridLength x:Key="StateColumnWidth">120</GridLength>
  <!-- A pane's list, narrow enough that the name keeps room in a quarter-width pane. -->
  <GridLength x:Key="PaneSizeColumnWidth">80</GridLength>
  <GridLength x:Key="PaneTypeColumnWidth">110</GridLength>
  <GridLength x:Key="PaneModifiedColumnWidth">120</GridLength>
  <GridLength x:Key="PaneStatusColumnWidth">90</GridLength>
  <GridLength x:Key="ActivityAreaColumnWidth">90</GridLength>
  <GridLength x:Key="ActivityItemColumnWidth">100</GridLength>
  <GridLength x:Key="ActivityStateColumnWidth">140</GridLength>
  <GridLength x:Key="ChecksumSizeColumnWidth">80</GridLength>
  <!-- A SHA-256 in hex, whole. -->
  <GridLength x:Key="ChecksumHashColumnWidth">470</GridLength>
  <GridLength x:Key="KeyPickerUsedByColumnWidth">70</GridLength>
  <GridLength x:Key="KeyStoreUsedByColumnWidth">80</GridLength>
  <GridLength x:Key="InspectorCurrentColumnWidth">70</GridLength>
  <GridLength x:Key="InspectorModifiedColumnWidth">170</GridLength>
  <GridLength x:Key="InspectorDeleteMarkerColumnWidth">100</GridLength>
  <GridLength x:Key="OverviewWorkspaceNameColumnWidth">176</GridLength>
  <GridLength x:Key="OverviewLocationColumnWidth">336</GridLength>
  <GridLength x:Key="OverviewProviderColumnWidth">120</GridLength>
  <GridLength x:Key="RunIndexColumnWidth">60</GridLength>
  <GridLength x:Key="RunActionColumnWidth">100</GridLength>
  <GridLength x:Key="RunExpectedBytesColumnWidth">105</GridLength>
  <GridLength x:Key="RunSafetyColumnWidth">210</GridLength>
  <GridLength x:Key="SyncTaskBehaviorColumnWidth">180</GridLength>
  <GridLength x:Key="SyncTaskStateColumnWidth">180</GridLength>
  <GridLength x:Key="LastSyncStateColumnWidth">240</GridLength>
  <GridLength x:Key="QueueOperationColumnWidth">140</GridLength>
  <GridLength x:Key="QueueProgressColumnWidth">160</GridLength>
  <GridLength x:Key="QueueAttemptColumnWidth">90</GridLength>

  <!--
    Window sizes: each window's opening size and the smallest it can be made. A window sized to its
    content has only a width.
  -->
  <sys:Double x:Key="MainWindowWidth">1500</sys:Double>
  <sys:Double x:Key="MainWindowHeight">920</sys:Double>
  <sys:Double x:Key="MainWindowMinWidth">1120</sys:Double>
  <sys:Double x:Key="MainWindowMinHeight">720</sys:Double>
  <sys:Double x:Key="SettingsWindowWidth">1160</sys:Double>
  <sys:Double x:Key="SettingsWindowHeight">780</sys:Double>
  <sys:Double x:Key="SettingsWindowMinWidth">1080</sys:Double>
  <sys:Double x:Key="SettingsWindowMinHeight">720</sys:Double>
  <sys:Double x:Key="ConnectionEditorWidth">880</sys:Double>
  <sys:Double x:Key="ConnectionEditorHeight">760</sys:Double>
  <sys:Double x:Key="ConnectionEditorMinWidth">720</sys:Double>
  <sys:Double x:Key="ConnectionEditorMinHeight">620</sys:Double>
  <sys:Double x:Key="ConnectionPickerWidth">380</sys:Double>
  <sys:Double x:Key="ConnectionPickerHeight">380</sys:Double>
  <sys:Double x:Key="BatchRenameWindowWidth">620</sys:Double>
  <sys:Double x:Key="BatchRenameWindowHeight">460</sys:Double>
  <sys:Double x:Key="BatchRenameWindowMinWidth">480</sys:Double>
  <sys:Double x:Key="BatchRenameWindowMinHeight">360</sys:Double>
  <sys:Double x:Key="ChecksumsWindowWidth">1000</sys:Double>
  <sys:Double x:Key="ChecksumsWindowHeight">480</sys:Double>
  <sys:Double x:Key="ChecksumsWindowMinWidth">720</sys:Double>
  <sys:Double x:Key="ChecksumsWindowMinHeight">320</sys:Double>
  <sys:Double x:Key="DiagnosticsWindowWidth">760</sys:Double>
  <sys:Double x:Key="DiagnosticsWindowHeight">480</sys:Double>
  <sys:Double x:Key="DiagnosticsWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="DiagnosticsWindowMinHeight">340</sys:Double>
  <sys:Double x:Key="FileSearchWindowWidth">900</sys:Double>
  <sys:Double x:Key="FileSearchWindowHeight">540</sys:Double>
  <sys:Double x:Key="FileSearchWindowMinWidth">640</sys:Double>
  <sys:Double x:Key="FileSearchWindowMinHeight">360</sys:Double>
  <sys:Double x:Key="FolderCompareWindowWidth">1040</sys:Double>
  <sys:Double x:Key="FolderCompareWindowHeight">620</sys:Double>
  <sys:Double x:Key="FolderCompareWindowMinWidth">760</sys:Double>
  <sys:Double x:Key="FolderCompareWindowMinHeight">420</sys:Double>
  <sys:Double x:Key="FtpConsoleWindowWidth">820</sys:Double>
  <sys:Double x:Key="FtpConsoleWindowHeight">520</sys:Double>
  <sys:Double x:Key="FtpConsoleWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="FtpConsoleWindowMinHeight">340</sys:Double>
  <sys:Double x:Key="InstallationCheckWindowWidth">680</sys:Double>
  <sys:Double x:Key="InstallationCheckWindowHeight">560</sys:Double>
  <sys:Double x:Key="InstallationCheckWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="InstallationCheckWindowMinHeight">420</sys:Double>
  <sys:Double x:Key="KeyStorePickerWindowWidth">820</sys:Double>
  <sys:Double x:Key="KeyStorePickerWindowHeight">420</sys:Double>
  <sys:Double x:Key="KeyStorePickerWindowMinWidth">680</sys:Double>
  <sys:Double x:Key="KeyStorePickerWindowMinHeight">360</sys:Double>
  <sys:Double x:Key="KeyStoreWindowWidth">980</sys:Double>
  <sys:Double x:Key="KeyStoreWindowHeight">560</sys:Double>
  <sys:Double x:Key="KeyStoreWindowMinWidth">820</sys:Double>
  <sys:Double x:Key="KeyStoreWindowMinHeight">460</sys:Double>
  <sys:Double x:Key="ObjectInspectorWindowWidth">1120</sys:Double>
  <sys:Double x:Key="ObjectInspectorWindowHeight">720</sys:Double>
  <sys:Double x:Key="ObjectInspectorWindowMinWidth">860</sys:Double>
  <sys:Double x:Key="ObjectInspectorWindowMinHeight">560</sys:Double>
  <sys:Double x:Key="ScheduleManagerWindowWidth">1180</sys:Double>
  <sys:Double x:Key="ScheduleManagerWindowHeight">720</sys:Double>
  <!-- The editor column at its width, and room beside it for a list that still reads. -->
  <sys:Double x:Key="ScheduleManagerWindowMinWidth">900</sys:Double>
  <sys:Double x:Key="ScheduleManagerWindowMinHeight">560</sys:Double>
  <sys:Double x:Key="SettingsExportWindowWidth">660</sys:Double>
  <sys:Double x:Key="SettingsExportWindowHeight">640</sys:Double>
  <sys:Double x:Key="SettingsExportWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="SettingsExportWindowMinHeight">480</sys:Double>
  <sys:Double x:Key="SettingsImportWindowWidth">660</sys:Double>
  <sys:Double x:Key="SettingsImportWindowHeight">560</sys:Double>
  <sys:Double x:Key="SettingsImportWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="SettingsImportWindowMinHeight">460</sys:Double>
  <sys:Double x:Key="StagingCleanupWindowWidth">960</sys:Double>
  <sys:Double x:Key="StagingCleanupWindowHeight">540</sys:Double>
  <sys:Double x:Key="StagingCleanupWindowMinWidth">720</sys:Double>
  <sys:Double x:Key="StagingCleanupWindowMinHeight">380</sys:Double>
  <sys:Double x:Key="SyncLocationPickerWindowWidth">720</sys:Double>
  <sys:Double x:Key="SyncLocationPickerWindowHeight">540</sys:Double>
  <sys:Double x:Key="SyncLocationPickerWindowMinWidth">560</sys:Double>
  <sys:Double x:Key="SyncLocationPickerWindowMinHeight">400</sys:Double>
  <sys:Double x:Key="SyncProfileEditorWindowWidth">1040</sys:Double>
  <sys:Double x:Key="SyncProfileEditorWindowHeight">760</sys:Double>
  <!-- Narrow enough for 1366x768, wide enough for the two locations side by side. -->
  <sys:Double x:Key="SyncProfileEditorWindowMinWidth">860</sys:Double>
  <sys:Double x:Key="SyncProfileEditorWindowMinHeight">600</sys:Double>
  <sys:Double x:Key="AboutWindowWidth">500</sys:Double>
  <sys:Double x:Key="AgentControlWindowWidth">520</sys:Double>
  <sys:Double x:Key="AgentHostModeWindowWidth">580</sys:Double>
  <sys:Double x:Key="IconPickerWindowWidth">420</sys:Double>
  <sys:Double x:Key="KeyStoreImportWindowWidth">560</sys:Double>
  <sys:Double x:Key="NewWorkspaceWindowWidth">660</sys:Double>
  <sys:Double x:Key="SplashWindowWidth">420</sys:Double>
  <sys:Double x:Key="UpdateCheckerWindowWidth">520</sys:Double>

  <!--
    Type scale. Sizes are in device-independent pixels; the WinForms shell wrote points, and its
    9pt and 10pt Segoe UI become 12 and 13 here (points x 96/72).
  -->
  <!-- Badges, pills and the pane's captions: a step below FontSizeCaption. -->
  <sys:Double x:Key="FontSizeMicro">10</sys:Double>
  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeBody">12</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">13</sys:Double>
  <sys:Double x:Key="FontSizeTitle">15</sys:Double>
  <sys:Double x:Key="FontSizeHeading">20</sys:Double>

  <!--
    Icon sizes, matching the grid UiIcons authored on. A glyph is drawn as vector geometry rather
    than rasterised per scaling, so these are the only sizes the shell needs to name - and nothing
    re-rasterises when the display scaling changes.
  -->
  <!-- A glyph beside a label in a button, and the pane tree's loading spinner. -->
  <sys:Double x:Key="IconSizeXs">14</sys:Double>
  <sys:Double x:Key="IconSizeSm">16</sys:Double>
  <sys:Double x:Key="IconSizeMd">18</sys:Double>
  <sys:Double x:Key="IconSizeLg">20</sys:Double>
  <sys:Double x:Key="IconSizeXl">24</sys:Double>
  <!-- Every Lucide glyph's line weight, a little lighter than the library's 2. -->
  <sys:Double x:Key="IconStrokeWidth">1.75</sys:Double>

  <!-- Long enough to read as movement, short enough never to be waited on. -->
  <sys:TimeSpan x:Key="DurationFast">0:0:0.12</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurationNormal">0:0:0.2</sys:TimeSpan>

</ResourceDictionary>
