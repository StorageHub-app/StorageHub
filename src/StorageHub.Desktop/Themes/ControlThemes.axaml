<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every rule here reads its numbers and colours from DesignTokens.axaml. Nothing in this file
    names a colour or a pixel, which is the whole point: changing how the shell looks means editing
    one file, not hunting through styles.

    This replaces roughly 3,900 lines of owner-drawn controls. StorageHubChoiceField alone was a
    combo box written from scratch - its own item collection, popup, keyboard navigation and
    accessible object - because WinForms could not be made to agree with the rest of the shell about
    a border colour.
  -->

  <Styles.Resources>

    <!--
      The tab, drawn here rather than themed on top of Fluent's.

      Fluent shows its accent pipe on hover as well as on selection, at a slightly lower opacity.
      On a dark bar that reads as selection: hovering a tab made it look like the one you were on,
      while the tab you were actually on stopped standing out. Since the strip appears three times
      over - workspaces, the queue, and a page's own sub-tabs - owning the template is cheaper than
      overriding parts of somebody else's by name.
    -->
    <!--
      Boxed, as 1.4 drew them (ui-reference 01, 03, 05): every tab is a raised box of its own with a
      minimum width, and the selected one carries the accent along its top edge. An underline under
      bare text was the Fluent idiom and made the strip read as a different app.
    -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      <Setter Property="MinWidth" Value="{StaticResource TabMinWidth}"/>
      <Setter Property="Margin" Value="{StaticResource TabMargin}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource TabRadius}" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <!-- The accent belongs to selection alone. -->
              <Border Name="PART_Accent" Grid.Row="0"
                      Height="{StaticResource TabAccentThickness}"
                      Background="Transparent"/>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Accent">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </ControlTheme>

    <!-- A tab strip that can carry one extra control after its tabs. Only the workspace strip uses
         it; the queue's tabs are a plain TabControl. -->
    <ControlTheme x:Key="WorkspaceTabControl" TargetType="TabControl">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}">
              <ItemsPresenter DockPanel.Dock="Left"
                              Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"/>
              <ContentPresenter Content="{TemplateBinding Tag}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
  </Style>

  <!--
    The window sets the text colour and everything inherits it; there is deliberately no blanket
    TextBlock setter. One would win over inheritance, which is how the sidebar's New button came to
    draw a near-black label on a blue fill in light appearance and got away with it in dark, where
    the page colour happens to be white. A container that paints itself now decides the colour of
    the text it contains, which is the only arrangement that cannot drift.
  -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <!--
    A status line whose colour carries as much as its words: a run that failed and one that is
    waiting for approval must not read the same at a glance. The tone comes from the model rather
    than from the view choosing a brush per screen, which is how the same state ended up green in
    one place and grey in another.
  -->
  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.status.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.status.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.status.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.status.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!--
    The same three tones on any text, not only a status line. A refusal under a field or a warning
    heading was written as "caption danger" or "heading warning" in several windows and drew in the
    plain caption colour, because only .status carried a tone. Declared after .caption and .muted so
    the tone is the colour that wins.
  -->
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!--
    The bar behind a transfer's progress text. As tall as the row allows and quiet in colour, so the
    percentage on top of it stays the thing that is read; green once the transfer is complete.
  -->
  <Style Selector="ProgressBar.transfer">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="ProgressBar.transfer.complete">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="ProgressBar.transfer.none">
    <Setter Property="Opacity" Value="0"/>
  </Style>

  <!-- Text that goes somewhere when clicked: coloured as a link and underlined, since colour
       alone is not something everybody can see. -->
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>

  <!-- A button that reads as a link: no box, the accent, underlined, e.g. the pane's "Load more". -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryHoverBrush}"/>
  </Style>

  <!-- The three button variants StorageHubButton painted by hand. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!--
    A button whose content is written out - an icon beside a label, rather than a bare string - has
    real children rather than template children, and LucideIcon's muted default would still beat
    what the button set. These say it again for the two filled variants.
  -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.primary LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!--
    A dialog's own buttons: OK, Cancel, Yes, No, Apply. The standard Windows size rather than
    Fluent's, which is drawn for touch and made every message box look like a form.
  -->
  <Style Selector="Button.dialog">
    <Setter Property="MinWidth" Value="{StaticResource DialogButtonMinWidth}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource DialogButtonPadding}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- The band along a dialog's foot that holds its buttons, a shade off the content above it. -->
  <Style Selector="Border.dialog-footer">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="{StaticResource DialogFooterPadding}"/>
  </Style>
  <Style Selector="Border.dialog-footer CheckBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- The dense variant, for anything hosted in the toolbar. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource DenseFieldPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>
  <!--
    An unavailable tool stays flat and dims, as 1.4's did. Fluent fills a disabled button's
    presenter with its own grey, and most toolbar and queue commands are unavailable most of the
    time, so the whole bar read as a row of filled boxes.
  -->
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <!--
    A tool that is on, such as the connections panel's while the panel shows: a square frame in the
    accent with no fill, the toolbar showing through, as 1.4 drew a checked toolbar button
    (ui-reference 01). The frame comes out of the padding, so a checked tool is the same size as
    the others and the bar does not shift when it is toggled.
  -->
  <Style Selector="Button.tool.checked">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource CheckedToolBorder}"/>
    <Setter Property="Padding" Value="{StaticResource CheckedToolPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource CheckedToolRadius}"/>
  </Style>
  <Style Selector="Button.tool.checked:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <!--
    A main toolbar button's label, as Settings asks for it: hidden (icons only, how the toolbar has
    always looked), beside the icon, or under it, as 1.4's three label styles drew them. The toolbar
    sets "labels" and "under" from the saved style. Hidden here rather than on the TextBlock, since
    a local value would win over the styles that show it.
  -->
  <Style Selector="StackPanel.tool-content">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="{StaticResource SpaceSm}"/>
  </Style>
  <Style Selector="ItemsControl.under StackPanel.tool-content">
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Spacing" Value="{StaticResource SpaceXs}"/>
  </Style>
  <Style Selector="TextBlock.tool-label">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="ItemsControl.labels TextBlock.tool-label">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>

  <!-- UiCard, and the accent rail it drew down the left edge of a connection card. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="{StaticResource PaddingSm}"/>
    <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}"/>
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="{StaticResource StatusBarPadding}"/>
    <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}"/>
  </Style>
  <!-- A cell of the status bar, and the line after one, as 1.4's StatusStrip drew them. Each cell
       is centred in the bar's one row rather than padded into it, so every cell sits on the same
       line and the bar stays StatusBarHeight tall. -->
  <Style Selector=":is(Control).status-cell">
    <Setter Property="Margin" Value="{StaticResource StatusCellMargin}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.statusbar-separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Width" Value="1"/>
    <Setter Property="Margin" Value="{StaticResource StatusSeparatorMargin}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <!-- The agent cell takes a click, as 1.4's did, and looks like the other cells all the same:
       no box, no fill on hover or press, and not dimmed where nothing opens Agent control. -->
  <Style Selector="Button.status-cell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.status-cell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.status-cell:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.status-cell:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- A workspace pane, and the border that says which one has focus. -->
  <!-- Three wide on every pane, as 1.x's pane frame was, so the active one's colour reads. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>
  <!--
    The active pane is marked by colour alone, never by a thicker border. Two panes sit side by
    side and the whole point of them is comparing one listing against the other; a border that
    grows by a pixel moves every row in that pane down by one, so the two stop lining up exactly
    when somebody is looking hardest.
  -->
  <Style Selector="Border.pane.active">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="MinHeight" Value="{StaticResource MenuBarHeight}"/>
  </Style>

  <!-- A menu bar header. Fluent paints its hover in a light neutral that reads as a grey box on a
       dark bar; the shell has always used its own muted surface for this. -->
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="{StaticResource MenuItemPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>
  <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <!-- The drop-down itself: an elevated surface with a real edge, rather than a panel that merges
       into whatever is behind it. -->
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingSm}"/>
  </Style>

  <Style Selector="MenuItem > MenuItem">
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
    <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}"/>
  </Style>
  <Style Selector="MenuItem > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>

  <!-- The Workspace menu's "Pinned" and "Recent": disabled, and bold, as 1.x drew its headings.
       A workspace whose file has gone is muted but still clickable, since clicking it is what
       offers to take it off the list. MainWindow marks the entries. -->
  <Style Selector="MenuItem > MenuItem.heading">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="MenuItem > MenuItem.missing">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <!-- A line between groups is an entry labelled "-". It is as tall as the line, not a row. -->
  <Style Selector="MenuItem > MenuItem:separator">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <!--
    A ticked entry in the menu bar, View > Connections Panel while the panel shows: framed around
    its own icon, as 1.4's menus drew a check, with the toolbar button's frame. Fluent puts its tick
    in a column that exists only while something is ticked, so the whole menu widened and every
    entry moved sideways each time the panel was shown or hidden. The icon's slot clips what it
    holds, which is let go here so the frame can draw outside it. "framed-check" is the same entry
    in the toolbar chevron's menu, which is a flyout rather than part of the menu bar.
  -->
  <Style Selector="Menu MenuItem:toggle /template/ ContentControl#PART_ToggleIconPresenter,
                   MenuItem.framed-check:toggle /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Menu MenuItem:toggle /template/ ContentControl#PART_IconPresenter,
                   MenuItem.framed-check:toggle /template/ ContentControl#PART_IconPresenter">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="Menu MenuItem:toggle /template/ ContentControl#PART_IconPresenter /template/ Viewbox,
                   MenuItem.framed-check:toggle /template/ ContentControl#PART_IconPresenter /template/ Viewbox">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="Border.menu-check">
    <Setter Property="Margin" Value="{StaticResource MenuCheckOutset}"/>
    <Setter Property="Padding" Value="{StaticResource MenuCheckPadding}"/>
    <Setter Property="BorderThickness" Value="{StaticResource CheckedToolBorder}"/>
    <Setter Property="CornerRadius" Value="{StaticResource CheckedToolRadius}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.menu-check.checked">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <!-- The shortcut column reads as reference, not as an action. -->
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="{StaticResource PaddingLg}"/>
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
  </Style>

  <!-- Compact tab headers, closer to the shell's own than Fluent's default. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding" Value="{StaticResource TabPadding}"/>
    <Setter Property="MinHeight" Value="{StaticResource TabHeight}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- Icons are geometry, so tone is just the stroke brush and an appearance change repaints it.
       The WinForms set had to re-rasterize every tracked glyph and re-tint it through a weak
       registry to achieve the same thing. -->
  <!-- A top-level menu gained a submenu chevron the moment its items came from the catalog, because
       Fluent draws one for any MenuItem that has children. A menu bar's roots always have children,
       so the indicator says nothing and costs a menu's worth of width. -->
  <Style Selector="Menu > MenuItem /template/ Path">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <Style Selector="LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="StrokeWidth" Value="1.75"/>
  </Style>
  <Style Selector="LucideIcon.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="LucideIcon.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.tool:pointerover LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <!--
    A tool button in a colour of its own, hover included: the connections panel's New in the
    accent, so it reads as the thing to press without being a filled pill, and Delete under the
    details in the danger colour, as text and icon rather than a red box.
  -->
  <Style Selector="Button.tool.emphasis LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.tool.emphasis TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.tool.danger LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.tool.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <!-- The connection details' actions once the panel is too narrow for their labels: icons, each
       with its label as a tooltip, all four alike. -->
  <Style Selector="DockPanel.detail-actions.compact Button.tool TextBlock">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!--
    A group in the connections panel: a quiet heading, and rows that sit under it.
  -->
  <Style Selector="Grid.group-header">
    <Setter Property="Height" Value="{StaticResource GroupHeaderHeight}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <Style Selector="TextBlock.group-title">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- How many connections a group holds, quieter than its name. -->
  <Style Selector="TextBlock.group-count">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="{StaticResource GroupCountMargin}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Panel.group-glyph">
    <Setter Property="Width" Value="{StaticResource GroupGlyphSize}"/>
    <Setter Property="Height" Value="{StaticResource GroupGlyphSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- A group's colour: a small tile behind its icon, as a card wears its colour, white glyph and
       all, so a dark colour reads on a dark scheme as well as a light one. -->
  <Style Selector="Border.group-tile">
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>
  <Style Selector="Border.group-tile LucideIcon">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- An open group with nothing in it: one quiet line under its name, not a blank block. -->
  <Style Selector="TextBlock.group-empty">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="{StaticResource GroupEmptyMargin}"/>
  </Style>

  <!--
    What is left of the Storage and Clients split: two or three letters beside the name. Storage is
    the quiet case because most connections are storage, and a badge on every row in the accent
    would make the accent mean nothing.
  -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
    <Setter Property="Padding" Value="4,1"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="Border.badge.client">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style Selector="Border.badge.client TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>

  <!--
    A badge that has to be read rather than merely noticed. The sync behaviour list puts "mirror,
    deleting whatever is not on the other side" next to "compare only"; nine equally grey badges
    would be nine words nobody reads before choosing.
  -->
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="Border.badge.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>

  <Style Selector="Border.badge.success">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <Style Selector="Border.badge.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <!--
    A connection card's parts (ui-reference 09): the rounded tile in the connection's own colour
    with a white glyph, its tags as quiet chips, and the provider badge in the details panel.
  -->
  <Style Selector="Border.card.connection-row">
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
  <Style Selector="Border.card.connection-row:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="Border.card.connection-row.selected">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <!-- A card reached with Tab shows where the keyboard is, as a focused row does. -->
  <Style Selector="Border.card.connection-row:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.icon-tile">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.icon-tile LucideIcon">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,1"/>
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="Border.detail-badge">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.detail-badge TextBlock">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Grid.detail-row">
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <!-- A section heading in the connection details, bold as 1.4 drew them, a step below the last
       fact of the section before. -->
  <Style Selector="TextBlock.detail-section">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="{StaticResource DetailSectionMargin}"/>
  </Style>

  <!-- A connection nobody can open reads as unavailable rather than as missing. -->
  <Style Selector="Border.connection-row.disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <!-- The group's own open/closed arrow, which is a ToggleButton and not a checkbox. -->
  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Content" Value="&#x25B8;"/>
  </Style>

  <Style Selector="ToggleButton.disclosure:checked">
    <Setter Property="Content" Value="&#x25BE;"/>
  </Style>

  <!--
    Through /template/, for the third time in this file: Fluent paints a ToggleButton's checked
    state inside its own template, so a transparent background set on the button itself loses and
    an open group wears the stock accent as a filled square.
  -->
  <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!--
    A pane's title bar: quiet, and a shade off the pane behind it so four panes read as four
    things rather than one grid of listings.
  -->
  <Style Selector="Border.pane-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
  </Style>

  <!-- A pane's folder tree: as dense as the list beside it, on the same surface. -->
  <Style Selector="TreeView.pane-tree">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0,4"/>
  </Style>
  <Style Selector="TreeView.pane-tree TreeViewItem">
    <Setter Property="MinHeight" Value="{StaticResource TreeRowHeight}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- A pane's list or tree while something is dragged over it that it would take: the selection
       colour, as 1.4 drew it. PaneDragHandler sets the class. -->
  <Style Selector="TreeView.pane-tree.drop-target">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>

  <!-- A pane's banner above the list: quiet for a note, the warning colour for a failure. -->
  <Style Selector="Button.pane-banner">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="Button.pane-banner.warning">
    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Button.pane-banner.warning /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
  </Style>
  <Style Selector="Button.pane-banner.warning:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Button.pane-banner TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
  </Style>

  <!-- The cover over a list being read. -->
  <Style Selector="Border.pane-loading">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <!-- The splash: the mark and the name on the surface, framed so a borderless window has an edge. -->
  <Style Selector="Border.splash">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="28,28,28,24"/>
  </Style>
  <Style Selector="TextBlock.splash-title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
  </Style>

  <!--
    The connection editor (ui-reference 08): a fixed header over the tabs, sections with a heading
    and a hint, the colour swatches, the badge preview and the transport notice.
  -->
  <Style Selector="Border.editor-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="16,12"/>
  </Style>
  <Style Selector="Border.editor-footer">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style Selector="TabControl.editor-tabs">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="8,6,0,0"/>
  </Style>
  <Style Selector="StackPanel.editor-section">
    <Setter Property="Margin" Value="16,16,24,8"/>
  </Style>
  <Style Selector="TextBlock.heading-sm">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <!-- The colour a picker has chosen wears the ring a hovered swatch does, so it can be found. -->
  <Style Selector="Button.swatch.chosen /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Border.badge-preview">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style Selector="Border.trust-notice">
    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="16,16,24,0"/>
  </Style>
  <Style Selector="Border.trust-notice TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.trust-notice.secure">
    <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
  </Style>
  <Style Selector="Border.trust-notice.secure TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <!--
    A pane's connection bar, as 1.x drew it (ui-reference 05): two framed boxes on the surface,
    one naming the connection with its badges, one saying how it is and holding the picker.
  -->
  <Style Selector="Border.pane-chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="TextBlock.pane-chip-name">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- A rounded badge in a pane's chip: STORAGE in the accent, the protocol muted. -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,1"/>
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="Border.pill.primary">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.pill.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.pill.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>

  <!--
    Where a secret came from, as a pill inside the box that shows it (SecretReferenceBox) and in
    the connection details: Key Store in the accent, Vault muted, Missing from Key Store in amber.
  -->
  <Style Selector="TextBox Border.pill.secret-source">
    <Setter Property="Margin" Value="{StaticResource SecretSourceBadgeMargin}"/>
  </Style>

  <!-- The state line: its colour says what its words say. -->
  <Style Selector="TextBlock.pane-state">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.pane-state.ready">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.pane-state.busy">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.pane-state.failed">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>

  <!-- The flat, bordered button that opens a pane's connection picker. -->
  <Style Selector="Button.picker">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Padding" Value="{StaticResource DenseFieldPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>

  <!-- The FILES row: a strip on the surface with its small capitalised caption. -->
  <Style Selector="Border.pane-commands">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1"/>
    <Setter Property="Padding" Value="8,2"/>
  </Style>
  <Style Selector="TextBlock.pane-caption">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="2,0,4,0"/>
  </Style>

  <!-- A drop-down in a toolbar: as tall as the buttons beside it. -->
  <Style Selector="ComboBox.dense">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>

  <!-- A field in a pane's navigation row: as tall as the buttons beside it, not a dialog's. -->
  <Style Selector="TextBox.dense">
    <Setter Property="Padding" Value="{StaticResource DenseFieldPadding}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>

  <!--
    A card in the New Workspace chooser: a picture of an arrangement, its name, and what it is for.
    Quiet until it is pointed at, because six lit cards would be six things asking to be pressed.
  -->
  <Style Selector="Button.preset">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <!--
    A terminal is a surface, not a card: darker than the listing beside it in both appearances, so
    a shell pane reads as a different kind of thing at a glance rather than as a listing that
    failed to load. The scheme supplies the colour, which is what keeps it the same on both
    platforms.
  -->
  <Style Selector="Border.terminal">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <Style Selector="Border.toolbar-separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Width" Value="1"/>
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.tab-add">
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
  </Style>

  <!-- The X on a workspace tab: small, and pushed away from the title so it is not hit by accident. -->
  <Style Selector="Button.tab-close">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="12,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- The agent cell is coloured by state, not painted green and hoped for. -->
  <Style Selector="TextBlock.agent">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.agent.healthy">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.agent.degraded">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.agent.down">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!-- The update cell, in 1.4's colours for each state of the updater, with a hand over it, as
       1.4's link had. -->
  <Style Selector="Button.status-cell.link">
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="TextBlock.update">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.update.ready">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.update.available">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.update.failed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!-- An overview metric card: a surface with a coloured rail down its left edge, which is what
       UiCard drew by hand and re-tinted through the theme walker. -->
  <Style Selector="Border.metric">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="2,1,1,1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
  </Style>
  <Style Selector="Border.metric.primary">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.metric.success">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Border.metric.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.metric.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.metric-value.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!-- A folder or a drive in a listing, when there is no system icon: the folder colour, as a
       file manager's folders are, so they stand apart from the files beside them. -->
  <Style Selector="LucideIcon.folder">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>

  <Style Selector="LucideIcon.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="LucideIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>

  <!-- A titled block on a page, as the overview and the sync pages use. -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
  </Style>

  <Style Selector="TabControl.subtabs > TabItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
    <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <Style Selector="TableView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
  </Style>
  <Style Selector="TableView.drop-target">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>

  <!--
    Column headings as 1.4 drew them (ui-reference 01, 05): regular weight, muted, with a rule
    underneath. Fluent's are semibold. The band's colour and padding are Fluent resources, which
    DesignTokens.axaml redefines; the template sets them locally, so a style here cannot.
  -->
  <Style Selector="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TableView /template/ ScrollViewer#PART_ScrollViewer /template/ DockPanel#ContentPanel > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TableView /template/ ScrollViewer#PART_ScrollViewer /template/ Panel#PART_ScrollBarsSeparator">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!--
    An empty table's message ("No workspaces yet"), in a TableView or a ListBox. It is read, not
    used: the pointer passes through it, so it never lights up or takes a click, and the arrow keys
    step over it. PlaceholderRows sets the class and undoes any other way of selecting it.
  -->
  <Style Selector=":is(ListBoxItem).placeholder">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

</Styles>
