<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StorageHub.Desktop</RootNamespace>
    <AssemblyName>StorageHub.Desktop</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\storagehub.ico</ApplicationIcon>
    <!-- Binding typos become build errors rather than silently empty controls, which suits a
         codebase that already treats warnings as errors. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shell's view models are internal, as the WinForms shell's were, and its tests measure
         the real tree rather than a public facade of it. -->
    <InternalsVisibleTo Include="StorageHub.Desktop.Tests" />
  </ItemGroup>

  <!-- The translations ship beside the executable and are seeded into the user's localization
       directory on first run and after an upgrade (DesktopFrameworkPaths.SeedShippedTranslations).
       CodeLogic only generates English templates, and never overwrites a file that exists, so the
       real translations have to arrive as content. 1.4's project carried this item; it was lost
       with that project, and 2.0 spoke English whatever language was chosen. -->
  <ItemGroup>
    <Content Include="..\..\assets\localization\*.json"
             Link="localization\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application's own mark, for the windows that show it. The .ico above is what the
         executable carries; Avalonia draws a bitmap, and this is the same artwork as one. -->
    <AvaloniaResource Include="..\..\assets\branding\storagehub-icon.png" Link="Assets\storagehub-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Lucide.Avalonia" />
    <ProjectReference Include="..\StorageHub.Desktop.Core\StorageHub.Desktop.Core.csproj" />
  </ItemGroup>
  <!-- The Explorer drop broker is a native COM DLL, so building it needs the Visual Studio C++
       toolchain. Requiring that of every build meant a plain `dotnet build` of this project could
       not succeed without Visual Studio installed, and `dotnet test` on the solution inherited the
       same requirement through the shell's own test suite. It is opt-in instead: CI and
       eng/package-windows.ps1 pass -p:StorageHubBuildShellExtension=true. A build without it
       produces a shell whose broker is absent, which the shell reports rather than assuming.

       It was driven from the WinForms csproj, which would have orphaned the native project the
       day that shell was deleted. It belongs on the shell: the broker has to sit beside the
       executable that registers it. -->
  <PropertyGroup>
    <StorageHubBuildShellExtension Condition="'$(StorageHubBuildShellExtension)' == ''">false</StorageHubBuildShellExtension>
    <StorageHubCanBuildShellExtension>false</StorageHubCanBuildShellExtension>
    <StorageHubCanBuildShellExtension Condition="'$(StorageHubBuildShellExtension)' == 'true' and '$(DesignTimeBuild)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">true</StorageHubCanBuildShellExtension>
    <StorageHubVsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</StorageHubVsWhere>
    <StorageHubNativeProject>$(MSBuildProjectDirectory)\..\StorageHub.ShellExtension.Native\StorageHub.ShellExtension.Native.vcxproj</StorageHubNativeProject>
    <!-- Explorer loads the broker in-process, so it has to match the architecture the shell is
         published for; a build without a runtime follows the SDK's own, which is what runs it. -->
    <StorageHubNativeRuntime>$(RuntimeIdentifier)</StorageHubNativeRuntime>
    <StorageHubNativeRuntime Condition="'$(StorageHubNativeRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</StorageHubNativeRuntime>
    <StorageHubNativePlatform>x64</StorageHubNativePlatform>
    <StorageHubNativePlatform Condition="$(StorageHubNativeRuntime.EndsWith('-arm64'))">ARM64</StorageHubNativePlatform>
    <StorageHubNativeToolsComponent>Microsoft.VisualStudio.Component.VC.Tools.x86.x64</StorageHubNativeToolsComponent>
    <StorageHubNativeToolsComponent Condition="'$(StorageHubNativePlatform)' == 'ARM64'">Microsoft.VisualStudio.Component.VC.Tools.ARM64</StorageHubNativeToolsComponent>
    <StorageHubNativeOutput>$(MSBuildProjectDirectory)\..\StorageHub.ShellExtension.Native\$(StorageHubNativePlatform)\$(Configuration)\StorageHub.ShellExtension.Native.dll</StorageHubNativeOutput>
  </PropertyGroup>
  <Target Name="ReportExplorerDropBrokerSkipped"
          AfterTargets="Build"
          Condition="'$(StorageHubCanBuildShellExtension)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="High"
             Text="StorageHub Explorer integration was not built. Pass -p:StorageHubBuildShellExtension=true on Windows with the Visual Studio C++ build tools to include it." />
  </Target>
  <Target Name="ResolveStorageHubNativeMsBuild"
          Condition="'$(StorageHubCanBuildShellExtension)' == 'true'">
    <Error Condition="!Exists('$(StorageHubVsWhere)')"
           Text="StorageHub Explorer integration requires Visual Studio C++ build tools, but vswhere.exe was not found." />
    <Exec Command="&quot;$(StorageHubVsWhere)&quot; -latest -products * -requires $(StorageHubNativeToolsComponent) -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_StorageHubNativeMsBuildCandidate" />
    </Exec>
    <PropertyGroup>
      <StorageHubNativeMsBuild>@(_StorageHubNativeMsBuildCandidate)</StorageHubNativeMsBuild>
    </PropertyGroup>
    <Error Condition="'$(StorageHubNativeMsBuild)' == '' or !Exists('$(StorageHubNativeMsBuild)')"
           Text="StorageHub Explorer integration requires an installed Visual Studio C++ MSBuild toolchain." />
  </Target>
  <Target Name="BuildAndStageExplorerDropBroker"
          AfterTargets="Build"
          DependsOnTargets="ResolveStorageHubNativeMsBuild"
          Condition="'$(StorageHubCanBuildShellExtension)' == 'true'">
    <Exec Command="&quot;$(StorageHubNativeMsBuild)&quot; &quot;$(StorageHubNativeProject)&quot; /p:Configuration=$(Configuration) /p:Platform=$(StorageHubNativePlatform) /m" />
    <Error Condition="!Exists('$(StorageHubNativeOutput)')"
           Text="The StorageHub Explorer drop broker build did not produce $(StorageHubNativeOutput)." />
    <Copy SourceFiles="$(StorageHubNativeOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageExplorerDropBrokerForPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildAndStageExplorerDropBroker"
          Condition="'$(StorageHubCanBuildShellExtension)' == 'true'">
    <Copy SourceFiles="$(StorageHubNativeOutput)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)StorageHub.ShellExtension.Native.dll')"
           Text="The published StorageHub Desktop is missing its Explorer drop broker." />
  </Target>
</Project>
