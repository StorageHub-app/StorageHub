<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <!--
      Production projects are restored with both runtime graphs available so the
      committed lock files cover normal builds and the self-contained installer
      payloads for each platform. Test projects remain runtime-neutral.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
