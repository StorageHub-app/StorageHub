<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <!--
      Production projects are restored with every shipped runtime graph available so the
      committed lock files cover normal builds and the self-contained installer
      payloads for each platform and architecture. Test projects remain runtime-neutral.
    -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
