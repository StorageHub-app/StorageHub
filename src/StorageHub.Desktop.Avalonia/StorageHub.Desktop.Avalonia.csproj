<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StorageHub.Desktop</RootNamespace>
    <!-- Renamed to StorageHub.Desktop when the WinForms shell, which owns that name today, is
         deleted. Until then two projects cannot both produce it. -->
    <AssemblyName>StorageHub.Desktop.Avalonia</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\storagehub.ico</ApplicationIcon>
    <!-- Binding typos become build errors rather than silently empty controls, which suits a
         codebase that already treats warnings as errors. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\StorageHub.Desktop.Core\StorageHub.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
