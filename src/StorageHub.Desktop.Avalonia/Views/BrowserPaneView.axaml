<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
             xmlns:core="clr-namespace:StorageHub.Desktop;assembly=StorageHub.Desktop.Core"
             x:Class="StorageHub.Desktop.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneModel">

  <!--
    One pane: which connection, where in it, and what is there. The order down the panel is the
    order somebody works in - choose a connection, see the path, move through it, read the listing -
    and it is the order BrowserPaneControl put them in too.

    The ".." row is part of the listing rather than a button beside it, which is how every file
    manager since Norton Commander has done it and what makes a double-click enough to go up.
  -->

  <Border Classes="pane" Classes.active="{Binding IsActive}">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource SpaceSm}"
            Margin="{StaticResource PaddingMd}">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Connections}"
                  SelectedItem="{Binding Connection, Mode=TwoWay}"
                  PlaceholderText="{Binding Title}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:PaneConnection">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"
                            VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="1" Classes="tool" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding RefreshLabel}">
          <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
        </Button>
      </Grid>

      <!--
        Copy and move stage this pane's selection; paste puts what is staged into this pane. Three
        buttons rather than two because a workspace can hold four panes, and "the other one" stops
        naming anything past two. The commands come from the workspace, which is the only thing
        that knows there are other panes at all.
      -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="{StaticResource SpaceSm}"
            IsVisible="{Binding IsListing}"
            Margin="{StaticResource PaddingMd}">
        <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                   Text="{Binding SelectionSummary}"/>
        <Button Grid.Column="1" Classes="tool" Command="{Binding CopyCommand}"
                ToolTip.Tip="{Binding CopyHint}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="Copy" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding CopyLabel}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="tool" Command="{Binding MoveCommand}"
                ToolTip.Tip="{Binding MoveHint}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding MoveLabel}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="tool" Command="{Binding PasteCommand}"
                ToolTip.Tip="{Binding PasteHint}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <LucideIcon Kind="ClipboardPaste" Size="{StaticResource IconSizeSm}"/>
            <TextBlock Text="{Binding PasteLabel}"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*"
            ColumnSpacing="{StaticResource SpaceXs}"
            IsVisible="{Binding IsListing}"
            Margin="{StaticResource PaddingMd}, 0, {StaticResource PaddingMd}, {StaticResource PaddingMd}">
        <Button Grid.Column="0" Classes="tool" Command="{Binding BackCommand}">
          <LucideIcon Kind="ArrowLeft" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <Button Grid.Column="1" Classes="tool" Command="{Binding ForwardCommand}">
          <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <Button Grid.Column="2" Classes="tool" Command="{Binding UpCommand}">
          <LucideIcon Kind="ArrowUp" Size="{StaticResource IconSizeSm}"/>
        </Button>
        <TextBox Grid.Column="3" Text="{Binding Path}" IsReadOnly="True"
                 VerticalAlignment="Center"/>
      </Grid>

      <!-- Sits over the table rather than replacing it: a failed navigation keeps the listing
           somebody was looking at, so a typo in a path costs nothing to recover from. -->
      <Border DockPanel.Dock="Bottom" Classes="toolbar"
              IsVisible="{Binding HasStatus}"
              Padding="{StaticResource PaddingMd}">
        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap"/>
      </Border>

      <!--
        The body is whichever of the two a pane is: a listing, or a terminal. Both live under the
        same chrome, so pointing a pane at an SSH client and back is the same gesture as switching
        between two buckets - which is what the connection picker above already implies.
      -->
      <Panel>
        <TableView ItemsSource="{Binding Rows}"
                   IsVisible="{Binding IsListing}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectedItems="{Binding SelectedRows}"
                   SelectionMode="Multiple">
          <TableView.Columns>
            <TableViewColumn Header="Name" Binding="{Binding Name}" Width="*"/>
            <TableViewColumn Header="Size" Binding="{Binding Size}" Width="110"/>
            <TableViewColumn Header="Type" Binding="{Binding Type}" Width="160"/>
            <TableViewColumn Header="Modified" Binding="{Binding Modified}" Width="150"/>
          </TableView.Columns>
        </TableView>

        <!--
          The SSH surface. VtTerminalEmulator and VtKeyEncoder are already in Desktop.Core with
          their own suites; what is not written yet is the painter that draws a screen buffer into
          a DrawingContext. It replaces the contents of this border and nothing around it, because
          everything a terminal pane needs from the workspace - being the active pane, being
          refused as a transfer endpoint, surviving a layout change - is settled here already.
        -->
        <Border Classes="terminal" IsVisible="{Binding IsTerminal}"
                Padding="{StaticResource PaddingLg}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="{StaticResource SpaceSm}">
            <LucideIcon Kind="SquareTerminal" Size="{StaticResource IconSizeLg}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center"/>
            <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding TerminalPending}"/>
            <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding TerminalConnectHint}"/>
          </StackPanel>
        </Border>
      </Panel>

    </DockPanel>
  </Border>
</UserControl>
