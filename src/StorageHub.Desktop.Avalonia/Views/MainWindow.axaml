<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageHub.Desktop.Views"
        x:Class="StorageHub.Desktop.Views.MainWindow"
        x:DataType="vm:ShellPreviewModel"
        Title="StorageHub"
        Width="1500" Height="920"
        MinWidth="1120" MinHeight="720">

  <!--
    The shell's structure, and nothing else: no colour, no pixel, no font. Every number below is a
    token from DesignTokens.axaml, which is what makes the appearance changeable in one file and
    what makes 125% scaling a non-event - Avalonia lays this out in device-independent pixels, so
    the same markup is correct at every scaling on both platforms.
  -->

  <DockPanel>

    <!-- In-window rather than NativeMenu: the requirement is the same classic menu bar on both
         platforms, and NativeMenu on Linux needs a dbusmenu host GNOME does not ship. -->
    <Menu DockPanel.Dock="Top" ItemsSource="{Binding Menus}">
      <Menu.ItemTemplate>
        <DataTemplate DataType="vm:MenuSection">
          <TextBlock Text="{Binding Header}"/>
        </DataTemplate>
      </Menu.ItemTemplate>
      <!-- One container theme drives every entry in every menu, which is what lets the nine menus
           come straight from the catalog. InputGesture only displays the shortcut; dispatch comes
           from Window.KeyBindings built from the same catalog, and the two must not drift. -->
      <Menu.Styles>
        <Style Selector="MenuItem > MenuItem" x:DataType="vm:CommandEntry">
          <Setter Property="Header" Value="{Binding Label}"/>
          <Setter Property="InputGesture" Value="{Binding Shortcut}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="ToolTip.Tip" Value="{Binding Description}"/>
          <Setter Property="ItemsSource" Value="{x:Null}"/>
          <Setter Property="Icon">
            <Template>
              <LucideIcon Kind="{Binding Icon}"
                          Size="{StaticResource IconSizeSm}"
                          Classes.primary="{Binding IsPrimary}"
                          Classes.danger="{Binding IsDanger}"/>
            </Template>
          </Setter>
        </Style>
      </Menu.Styles>
      <Menu.ItemContainerTheme>
        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                        x:DataType="vm:MenuSection">
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </ControlTheme>
      </Menu.ItemContainerTheme>
    </Menu>

    <!-- Avalonia has no ToolBar; an ItemsControl over the resolved command ids is the shape, and it
         keeps the toolbar data-driven the way UiCommandCatalog already made it. -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <ItemsControl ItemsSource="{Binding Toolbar}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <!-- Two templates matched by type, so ToolbarLayout's separator entries need no flag and no
             converter: the layout is a list of ids with "|" in it, exactly as it is persisted. -->
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:CommandEntry">
            <Button Classes="tool" Command="{Binding Command}" ToolTip.Tip="{Binding Description}">
              <LucideIcon Kind="{Binding Icon}"
                          Size="{StaticResource IconSizeMd}"
                          Classes.primary="{Binding IsPrimary}"
                          Classes.danger="{Binding IsDanger}"/>
            </Button>
          </DataTemplate>
          <DataTemplate DataType="vm:ToolbarSeparator">
            <Border Classes="toolbar-separator"/>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="muted"
                   Text="{Binding Status, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding ShellStatus.Location}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ShellStatus.SelectionText}"
                   Margin="{StaticResource PaddingLg}"/>
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ShellStatus.TransferRateText}"
                   Margin="{StaticResource PaddingLg}"/>
        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding ShellStatus.QueueText}"
                   Margin="{StaticResource PaddingLg}"/>
        <TextBlock Grid.Column="4" Classes="agent" Text="{Binding ShellStatus.AgentText}"
                   Classes.healthy="{Binding ShellStatus.AgentIsHealthy}"
                   Classes.down="{Binding ShellStatus.AgentIsDown}"
                   Margin="{StaticResource PaddingLg}"/>
      </Grid>
    </Border>

    <!-- What the two nested SplitContainers become. ApplyConnectionsPanelSide, which was 130 lines
         of width arithmetic, is a swap of two Grid.Column values here. -->
    <Grid ColumnDefinitions="Auto,Auto,*">
      <Border Grid.Column="0" Classes="surface"
              MinWidth="{StaticResource SidebarMinWidth}"
              MaxWidth="{StaticResource SidebarMaxWidth}"
              Width="260">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
                Margin="{StaticResource PaddingLg}">
            <TextBlock Classes="title" Text="{Binding Sidebar.Title}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="primary" Command="{Binding Sidebar.NewCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                <LucideIcon Kind="Plus" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding Sidebar.NewLabel}"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="tool" Margin="{StaticResource PaddingSm}"
                    ToolTip.Tip="{Binding Sidebar.MoreLabel}">
              <LucideIcon Kind="Ellipsis" Size="{StaticResource IconSizeSm}"/>
            </Button>
          </Grid>

          <!-- The search box carries its own glyph, as the owner-drawn field did. -->
          <Grid DockPanel.Dock="Top" Margin="12,0,12,0">
            <TextBox PlaceholderText="{Binding Sidebar.SearchPlaceholder}"
                     Padding="30,8,10,8"/>
            <LucideIcon Kind="Search" Size="{StaticResource IconSizeSm}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="{StaticResource PaddingLg}"/>
          </Grid>

          <!-- Details for the selected connection, below its own rule. Empty until one is picked,
               which is the state the shell spends most of its life in. -->
          <Border DockPanel.Dock="Bottom" Height="200"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                  Padding="{StaticResource PaddingLg}">
            <TextBlock Classes="muted" Text="{Binding Sidebar.DetailPlaceholder}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <Panel Margin="12,12,12,0">
            <TextBlock Classes="muted" Text="{Binding Sidebar.EmptyMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,24,0,0"
                       IsVisible="{Binding Sidebar.IsEmpty}"/>
            <ItemsControl ItemsSource="{Binding Connections}"
                          IsVisible="{Binding !Sidebar.IsEmpty}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource SpaceMd}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ConnectionCard">
                  <Border Classes="card" Classes.selected="{Binding IsSelected}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Classes="caption" Text="{Binding Detail}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="{StaticResource SplitterThickness}"/>

      <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
        <TabControl Grid.Row="0" ItemsSource="{Binding Workspaces}"
                    SelectedIndex="{Binding SelectedWorkspace}"
                    Theme="{StaticResource WorkspaceTabControl}">
          <!-- The "+" that adds a workspace. A sibling of the strip rather than a tab in it: the
               WinForms shell used a sentinel TabPage and vetoed selecting it in
               WorkspaceTabsSelecting, and Avalonia's TabControl.SelectionChanged cannot be
               cancelled. Templated into the strip, so it follows the last tab at any width. -->
          <TabControl.Tag>
            <Button Classes="tool tab-add" Command="{Binding NewWorkspaceCommand}"
                    ToolTip.Tip="{Binding NewWorkspaceLabel}">
              <LucideIcon Kind="Plus" Size="{StaticResource IconSizeSm}"/>
            </Button>
          </TabControl.Tag>
          <TabControl.ItemTemplate>
            <DataTemplate DataType="vm:WorkspaceTab">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"/>
                <TextBlock Text="{Binding Title}"/>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate DataType="vm:WorkspaceTab">
              <!-- A tab either carries a page of its own - Welcome, Sync tasks - or it is a
                   workspace, which is the pane grid. One template, chosen by whether Page is set. -->
              <Panel>
                <ContentControl Content="{Binding Page}"
                                IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:OverviewModel">
                      <vm:OverviewView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SyncTasksModel">
                      <vm:SyncTasksView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SyncRunHistoryModel">
                      <vm:SyncRunHistoryView/>
                    </DataTemplate>
                    <!-- A page that is itself tabbed. Sync tasks is the first, and the shape is
                         reusable rather than a second tab control written into the shell. -->
                    <DataTemplate DataType="vm:TabbedPageModel">
                      <TabControl ItemsSource="{Binding Tabs}" Classes="subtabs">
                        <TabControl.ItemTemplate>
                          <DataTemplate DataType="vm:PageTab">
                            <TextBlock Text="{Binding Title}"/>
                          </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                          <DataTemplate DataType="vm:PageTab">
                            <ContentControl Content="{Binding Content}">
                              <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:SyncTasksModel">
                                  <vm:SyncTasksView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:SyncRunHistoryModel">
                                  <vm:SyncRunHistoryView/>
                                </DataTemplate>
                              </ContentControl.DataTemplates>
                            </ContentControl>
                          </DataTemplate>
                        </TabControl.ContentTemplate>
                      </TabControl>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>

                <Grid ColumnDefinitions="*,Auto,*" Margin="{StaticResource PaddingMd}"
                      IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNull}}">
                <Border Grid.Column="0" Classes="pane" Classes.active="{Binding LeftIsActive}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LeftTitle}"
                               FontWeight="SemiBold" Margin="{StaticResource PaddingMd}"/>
                    <TableView ItemsSource="{Binding Left}">
                      <TableView.Columns>
                        <TableViewColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <TableViewColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                        <TableViewColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                      </TableView.Columns>
                    </TableView>
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="{StaticResource SplitterThickness}"/>
                <Border Grid.Column="2" Classes="pane">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RightTitle}"
                               FontWeight="SemiBold" Margin="{StaticResource PaddingMd}"/>
                    <TableView ItemsSource="{Binding Right}">
                      <TableView.Columns>
                        <TableViewColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <TableViewColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                        <TableViewColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                      </TableView.Columns>
                    </TableView>
                  </DockPanel>
                </Border>
                </Grid>
              </Panel>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <GridSplitter Grid.Row="1" Height="{StaticResource SplitterThickness}"
                      HorizontalAlignment="Stretch"/>

        <Border Grid.Row="2" Classes="surface" Height="240"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <DockPanel>
            <!-- The queue's own toolbar, above its tabs, exactly where TransferQueueControl put it. -->
            <Border DockPanel.Dock="Top" Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                  <Button Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                      <LucideIcon Kind="RefreshCw" Size="{StaticResource IconSizeSm}"/>
                      <TextBlock Text="{Binding Queue.RefreshLabel}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                      <LucideIcon Kind="Trash" Size="{StaticResource IconSizeSm}"/>
                      <TextBlock Text="{Binding Queue.CancelLabel}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                      <LucideIcon Kind="Play" Size="{StaticResource IconSizeSm}"/>
                      <TextBlock Text="{Binding Queue.RetryLabel}"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="muted" Text="{Binding Queue.ReconcileLabel}"
                             VerticalAlignment="Center" Margin="{StaticResource PaddingLg}"/>
                  <ComboBox ItemsSource="{Binding Queue.ReconcileActions}"
                            SelectedIndex="0" MinWidth="150"/>
                  <Button Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                      <LucideIcon Kind="CircleCheck" Size="{StaticResource IconSizeSm}"/>
                      <TextBlock Text="{Binding Queue.ApplyLabel}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                      <LucideIcon Kind="ArrowRight" Size="{StaticResource IconSizeSm}"/>
                      <TextBlock Text="{Binding Queue.NextLabel}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Queue.EmptyMessage}"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <TabControl ItemsSource="{Binding QueueTabs}">
              <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:QueueTab">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <LucideIcon Kind="{Binding Icon}" Size="{StaticResource IconSizeSm}"/>
                    <TextBlock Text="{Binding Title}"/>
                  </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
              <!-- Every tab shows the same six columns over a different filter, so one template
                   serves all seven. The rows arrive with the transfer queue client. -->
              <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:QueueTab">
                  <TableView ItemsSource="{Binding $parent[Window].((vm:ShellPreviewModel)DataContext).Queue.Rows}">
                    <TableView.Columns>
                      <TableViewColumn Header="Operation" Binding="{Binding Operation}" Width="140"/>
                      <TableViewColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                      <TableViewColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                      <TableViewColumn Header="Progress" Binding="{Binding Progress}" Width="160"/>
                      <TableViewColumn Header="Attempt" Binding="{Binding Attempt}" Width="90"/>
                      <TableViewColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                    </TableView.Columns>
                  </TableView>
                </DataTemplate>
              </TabControl.ContentTemplate>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
