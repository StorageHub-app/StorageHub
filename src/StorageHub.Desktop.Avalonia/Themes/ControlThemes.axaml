<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every rule here reads its numbers and colours from DesignTokens.axaml. Nothing in this file
    names a colour or a pixel, which is the whole point: changing how the shell looks means editing
    one file, not hunting through styles.

    This replaces roughly 3,900 lines of owner-drawn controls. StorageHubChoiceField alone was a
    combo box written from scratch - its own item collection, popup, keyboard navigation and
    accessible object - because WinForms could not be made to agree with the rest of the shell about
    a border colour.
  -->

  <Styles.Resources>

    <!--
      The tab, drawn here rather than themed on top of Fluent's.

      Fluent shows its accent pipe on hover as well as on selection, at a slightly lower opacity.
      On a dark bar that reads as selection: hovering a tab made it look like the one you were on,
      while the tab you were actually on stopped standing out. Since the strip appears three times
      over - workspaces, the queue, and a page's own sub-tabs - owning the template is cheaper than
      overriding parts of somebody else's by name.
    -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root" Background="{TemplateBinding Background}">
            <Grid RowDefinitions="*,Auto">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
              <!-- The accent belongs to selection alone. -->
              <Border Name="PART_Accent" Grid.Row="1"
                      Height="{StaticResource TabAccentThickness}"
                      Background="Transparent"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Accent">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </ControlTheme>

    <!-- A tab strip that can carry one extra control after its tabs. Only the workspace strip uses
         it; the queue's tabs are a plain TabControl. -->
    <ControlTheme x:Key="WorkspaceTabControl" TargetType="TabControl">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}">
              <ItemsPresenter DockPanel.Dock="Left"
                              Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"/>
              <ContentPresenter Content="{TemplateBinding Tag}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
  </Style>

  <!--
    The window sets the text colour and everything inherits it; there is deliberately no blanket
    TextBlock setter. One would win over inheritance, which is how the sidebar's New button came to
    draw a near-black label on a blue fill in light appearance and got away with it in dark, where
    the page colour happens to be white. A container that paints itself now decides the colour of
    the text it contains, which is the only arrangement that cannot drift.
  -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- The three button variants StorageHubButton painted by hand. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!--
    A button whose content is written out - an icon beside a label, rather than a bare string - has
    real children rather than template children, and LucideIcon's muted default would still beat
    what the button set. These say it again for the two filled variants.
  -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.primary LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!-- The dense variant, for anything hosted in the toolbar. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource DenseFieldPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
  </Style>

  <!-- UiCard, and the accent rail it drew down the left edge of a connection card. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="{StaticResource PaddingSm}"/>
    <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}"/>
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
    <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}"/>
  </Style>

  <!-- A workspace pane, and the border that says which one has focus. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <!--
    The active pane is marked by colour alone, never by a thicker border. Two panes sit side by
    side and the whole point of them is comparing one listing against the other; a border that
    grows by a pixel moves every row in that pane down by one, so the two stop lining up exactly
    when somebody is looking hardest.
  -->
  <Style Selector="Border.pane.active">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="MinHeight" Value="{StaticResource MenuBarHeight}"/>
  </Style>

  <!-- A menu bar header. Fluent paints its hover in a light neutral that reads as a grey box on a
       dark bar; the shell has always used its own muted surface for this. -->
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="{StaticResource MenuItemPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource DenseFieldRadius}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>
  <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <!-- The drop-down itself: an elevated surface with a real edge, rather than a panel that merges
       into whatever is behind it. -->
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource FieldRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingSm}"/>
  </Style>

  <Style Selector="MenuItem > MenuItem">
    <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
    <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}"/>
  </Style>
  <Style Selector="MenuItem > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>

  <!-- The shortcut column reads as reference, not as an action. -->
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="{StaticResource PaddingLg}"/>
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
  </Style>

  <!-- Compact tab headers, closer to the shell's own than Fluent's default. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
    <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- Icons are geometry, so tone is just the stroke brush and an appearance change repaints it.
       The WinForms set had to re-rasterize every tracked glyph and re-tint it through a weak
       registry to achieve the same thing. -->
  <!-- A top-level menu gained a submenu chevron the moment its items came from the catalog, because
       Fluent draws one for any MenuItem that has children. A menu bar's roots always have children,
       so the indicator says nothing and costs a menu's worth of width. -->
  <Style Selector="Menu > MenuItem /template/ Path">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <Style Selector="LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="StrokeWidth" Value="1.75"/>
  </Style>
  <Style Selector="LucideIcon.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="LucideIcon.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.tool:pointerover LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!--
    A pane's title bar: quiet, and a shade off the pane behind it so four panes read as four
    things rather than one grid of listings.
  -->
  <Style Selector="Border.pane-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
  </Style>

  <!--
    A card in the New Workspace chooser: a picture of an arrangement, its name, and what it is for.
    Quiet until it is pointed at, because six lit cards would be six things asking to be pressed.
  -->
  <Style Selector="Button.preset">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <!--
    A terminal is a surface, not a card: darker than the listing beside it in both appearances, so
    a shell pane reads as a different kind of thing at a glance rather than as a listing that
    failed to load. The scheme supplies the colour, which is what keeps it the same on both
    platforms.
  -->
  <Style Selector="Border.terminal">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <Style Selector="Border.toolbar-separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Width" Value="1"/>
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.tab-add">
    <Setter Property="Margin" Value="{StaticResource PaddingSm}"/>
  </Style>

  <!-- The agent cell is coloured by state, not painted green and hoped for. -->
  <Style Selector="TextBlock.agent">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.agent.healthy">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.agent.down">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <!-- An overview metric card: a surface with a coloured rail down its left edge, which is what
       UiCard drew by hand and re-tinted through the theme walker. -->
  <Style Selector="Border.metric">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="2,1,1,1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingLg}"/>
  </Style>
  <Style Selector="Border.metric.primary">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.metric.success">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Border.metric.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Border.metric.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.metric-value.primary">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="TextBlock.metric-value.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="LucideIcon.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="LucideIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>

  <!-- A titled block on a page, as the overview and the sync pages use. -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
  </Style>

  <Style Selector="TabControl.subtabs > TabItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
    <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}"/>
  </Style>

  <Style Selector="TableView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
  </Style>

</Styles>
