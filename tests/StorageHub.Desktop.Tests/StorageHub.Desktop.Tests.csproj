<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StorageHub.Desktop.Tests</RootNamespace>
    <!-- Avalonia.Headless.XUnit is built on xunit v3, and the rest of this solution is on 2.9.3.
         Nothing forces them to agree: a test project picks its own runner, and this is the only one
         that needs v3. Migrating fourteen suites to satisfy one would be the wrong way round. -->
    <UseXunitV3>true</UseXunitV3>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" VersionOverride="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StorageHub.Desktop\StorageHub.Desktop.csproj" />
  </ItemGroup>
</Project>
