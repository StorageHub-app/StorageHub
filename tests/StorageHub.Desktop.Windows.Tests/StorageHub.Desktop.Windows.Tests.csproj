<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StorageHub.Desktop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StorageHub.Desktop.Windows\StorageHub.Desktop.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied. The portable half of this suite lives in Desktop.Core.Tests and builds
         the same fixture out of the same four fakes; two copies that must agree is exactly the
         thing a link avoids. -->
    <Compile Include="..\StorageHub.Desktop.Core.Tests\LifecycleFixtures.cs"
             Link="LifecycleFixtures.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
