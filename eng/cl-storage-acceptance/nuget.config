<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- A locally packed build to check, e.g.
         dotnet pack CL.Storage/CL.Storage.csproj -c Release -p:Version=4.8.94-local.3 -o <folder>
         and set CL_STORAGE_FEED to that folder. -->
    <add key="local" value="%CL_STORAGE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
